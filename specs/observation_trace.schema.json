{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/observation_trace.schema.json",
  "title": "観測Trace（ObservationTrace）",
  "type": "object",
  "required": ["版", "TraceID", "SpanID一覧", "件数", "証拠種別", "生成源", "親TraceID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "TraceID": { "type": "string", "pattern": "^observation-trace-[1-9][0-9]*$" },
    "SpanID一覧": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "string", "pattern": "^observation-span-[1-9][0-9]*$" } },
    "件数": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "証拠種別": { "const": "INTERNAL_STATE" },
    "生成源": { "const": "broker_audit_finalization" },
    "親TraceID": { "type": ["string", "null"], "maxLength": 128 }
  }
}
