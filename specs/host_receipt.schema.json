{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/host_receipt.schema.json",
  "title": "Host登録receipt（HostReceipt）",
  "description": "Brokerが保持するHost metadata。Host metadataはPermission、Approval、Authority、Credentialを生成しない。",
  "type": "object",
  "required": ["版", "Host ID", "表示名", "Platform", "接続状態", "Trust", "証明書/identity", "Runtime summary", "最終接続", "公開範囲", "証拠種別", "権限生成", "authority_strip", "能力ID", "権限ID", "承認状態", "復旧ID", "登録監査ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "Host ID": { "$ref": "#/$defs/id" },
    "表示名": { "type": "string", "minLength": 1, "maxLength": 256 },
    "Platform": { "enum": ["windows", "linux", "macos", "android", "ios", "unknown"] },
    "接続状態": { "const": "pending_review" },
    "Trust": { "$ref": "#/$defs/trust" },
    "証明書/identity": { "$ref": "#/$defs/identity" },
    "Runtime summary": { "$ref": "#/$defs/runtime_summary" },
    "最終接続": { "type": "null" },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" },
    "権限生成": { "const": "なし" },
    "authority_strip": { "const": true },
    "能力ID": { "const": "host.registry.register" },
    "権限ID": { "const": "permission.host.registry.register" },
    "承認状態": { "const": "owner_control_approved" },
    "復旧ID": { "const": "recover-host-registration" },
    "登録監査ID": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "identity": {
      "type": "object",
      "required": ["種別", "hash"],
      "additionalProperties": false,
      "properties": {
        "種別": { "enum": ["certificate_hash", "identity_hash"] },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "trust": {
      "type": "object",
      "required": ["state", "evidence_source", "requires_operator_review"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "pending_review" },
        "evidence_source": { "const": "INTERNAL_STATE" },
        "requires_operator_review": { "const": true }
      }
    },
    "runtime_summary": {
      "type": "object",
      "required": ["runtime_count", "agent_count", "evidence_source"],
      "additionalProperties": false,
      "properties": {
        "runtime_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "agent_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "evidence_source": { "const": "INTERNAL_STATE" }
      }
    }
  }
}
