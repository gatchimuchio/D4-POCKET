{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mcp_tool_action_preview_receipt.schema.json",
  "title": "Compose MCP Tool実行Preview receipt",
  "description": "現在状態に束縛した読み取り専用Preview。権限・承認・外部作用は成立しない。",
  "type": "object",
  "required": ["version", "operation", "status", "server_id", "tool_id", "name", "arguments_hash", "compose_id", "compose_manifest_hash", "catalog_snapshot_hash", "connection_binding_hash", "host_switch_generation", "dependency_preview", "compatibility_preview", "permission_preview", "permission_generated", "approval_requested", "tool_effect_performed", "authority_strip", "evidence_source", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "operation": { "const": "MCP Tool実行Preview" },
    "status": { "const": "accepted" },
    "server_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tool_id": { "type": "string", "pattern": "^tool-[a-f0-9]{142}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "arguments_hash": { "$ref": "#/$defs/hash" },
    "compose_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "compose_manifest_hash": { "$ref": "#/$defs/hash" },
    "catalog_snapshot_hash": { "$ref": "#/$defs/hash" },
    "connection_binding_hash": { "$ref": "#/$defs/hash" },
    "host_switch_generation": { "$ref": "#/$defs/hash" },
    "dependency_preview": {
      "type": "object",
      "required": ["status", "observed_bindings", "incomplete_source_count", "unknown_source_count"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["known", "partial", "unknown"] },
        "observed_bindings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["source_kind", "source_id", "target_kind", "target_id"],
            "additionalProperties": false,
            "properties": {
              "source_kind": { "enum": ["runtime", "agent", "tool"] },
              "source_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "target_kind": { "enum": ["runtime", "adapter", "agent_instance", "mcp_server", "tool", "host"] },
              "target_id": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "incomplete_source_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "unknown_source_count": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    },
    "compatibility_preview": {
      "type": "object",
      "required": ["status", "checks", "unknown"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "observed_checks_passed" },
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["現在のRuntime／Agent／MCP Catalog選択", "現在のCapability宣言", "現在のMCP接続とTool arguments schema"] }
        },
        "unknown": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "未提供のpackage／ABI／Provider互換条件" }
        }
      }
    },
    "permission_preview": {
      "type": "object",
      "required": ["capability_id", "permission_id", "server_id", "tool_id", "arguments_hash", "permission_status", "approval_status", "requires_native_owner_confirmation"],
      "additionalProperties": false,
      "properties": {
        "capability_id": { "const": "mcp.tool.call" },
        "permission_id": { "const": "permission.mcp.tool.call.one_shot" },
        "server_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tool_id": { "type": "string", "pattern": "^tool-[a-f0-9]{142}$" },
        "arguments_hash": { "$ref": "#/$defs/hash" },
        "permission_status": { "const": "not_generated" },
        "approval_status": { "const": "not_requested" },
        "requires_native_owner_confirmation": { "const": true }
      }
    },
    "permission_generated": { "const": false },
    "approval_requested": { "const": false },
    "tool_effect_performed": { "const": false },
    "authority_strip": { "const": true },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "audit_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
