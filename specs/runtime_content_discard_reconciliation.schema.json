{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/runtime_content_discard_reconciliation.schema.json",
  "title": "部分破棄中断の現在owner復旧照合",
  "type": "object",
  "required": [
    "版",
    "要求ID",
    "要求hash",
    "部分保存破棄承認監査ID",
    "観測監査head",
    "観測時刻",
    "証拠種別",
    "状態"
  ],
  "additionalProperties": false,
  "properties": {
    "版": {
      "const": 1
    },
    "要求ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "要求hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "部分保存破棄承認監査ID": {
      "type": "string",
      "minLength": 1
    },
    "観測監査head": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "観測時刻": {
      "type": "integer",
      "minimum": 0
    },
    "証拠種別": {
      "const": "LIVE_RUNTIME"
    },
    "状態": {
      "const": "部分破棄中断照合済み"
    }
  }
}
