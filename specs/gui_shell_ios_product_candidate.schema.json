{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/gui_shell_ios_product_candidate.schema.json",
  "title": "iOS製品build候補証拠（IosProductBuildCandidate）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "evidence_source",
    "source_commit",
    "source_clean",
    "channel",
    "toolchain",
    "bundle_identity",
    "native_permissions",
    "device_link_contract",
    "simulator_artifact",
    "device_artifact",
    "relationship",
    "distribution_ready",
    "formal_distribution_claimed",
    "installed_product_verified"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "d4_pocket_ios_product_build_candidate" },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_clean": { "const": true },
    "channel": { "const": "qa_candidate" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flutter_version", "xcode_version", "host_platform"],
      "properties": {
        "flutter_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "xcode_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "host_platform": { "const": "macos" }
      }
    },
    "bundle_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_identifier", "version_name", "version_code", "owner_confirmed", "distribution_identity"],
      "properties": {
        "bundle_identifier": { "type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+){1,7}$" },
        "version_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "version_code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "owner_confirmed": { "const": false },
        "distribution_identity": { "const": false }
      }
    },
    "native_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_source", "simulator_usage_keys", "device_usage_keys", "source_entitlements_sha256", "source_entitlement_keys", "applied_entitlements_observed"],
      "properties": {
        "evidence_source": { "const": "built_info_plist_and_source_entitlements" },
        "simulator_usage_keys": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^NS[A-Za-z0-9]+UsageDescription$" } },
        "device_usage_keys": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^NS[A-Za-z0-9]+UsageDescription$" } },
        "source_entitlements_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_entitlement_keys": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,128}$" } },
        "applied_entitlements_observed": { "const": false }
      }
    },
    "device_link_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device_link_control.schema.json", "device_link_credential.schema.json", "device_link_invitation.schema.json", "device_link_request.schema.json"],
          "properties": {
            "device_link_control.schema.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "device_link_credential.schema.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "device_link_invitation.schema.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "device_link_request.schema.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "simulator_artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "properties": { "platform": { "const": "IOSSIMULATOR" }, "build_configuration": { "const": "debug" } } }
      ]
    },
    "device_artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "properties": { "platform": { "const": "IOS" }, "build_configuration": { "const": "release" } } }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_source_commit", "same_bundle_identifier", "distinct_artifact_hashes", "distinct_main_executable_hashes"],
      "properties": {
        "same_source_commit": { "const": true },
        "same_bundle_identifier": { "const": true },
        "distinct_artifact_hashes": { "const": true },
        "distinct_main_executable_hashes": { "const": true }
      }
    },
    "distribution_ready": { "const": false },
    "formal_distribution_claimed": { "const": false },
    "installed_product_verified": { "const": false }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "size_bytes", "bundle_identifier", "version_name", "version_code", "main_executable_sha256", "bundle_tree_sha256", "bundle_file_count", "bundle_uncompressed_bytes", "architectures", "platform", "build_configuration", "build_settings", "privacy_usage_keys", "app_bundle_signature_state", "signature_inspection", "provisioning_profile_present"],
      "properties": {
        "file_name": { "type": "string", "pattern": "^d4-pocket-ios-(simulator-app|device-app)\\.zip$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2000000000 },
        "bundle_identifier": { "type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+){1,7}$" },
        "version_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "version_code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "main_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bundle_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bundle_file_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "bundle_uncompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 2000000000 },
        "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arm64", "arm64e", "x86_64", "i386", "armv7", "armv7s"] } },
        "platform": { "enum": ["IOS", "IOSSIMULATOR"] },
        "build_configuration": { "enum": ["debug", "release"] },
        "build_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "configuration", "platform", "bundle_identifier", "version_name", "version_code", "sdk", "sdk_version", "minimum_os_version", "device_families", "architectures", "sha256"],
          "properties": {
            "target": { "const": "Runner" },
            "configuration": { "enum": ["debug", "release"] },
            "platform": { "enum": ["IOS", "IOSSIMULATOR"] },
            "bundle_identifier": { "type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+){1,7}$" },
            "version_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
            "version_code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
            "sdk": { "type": "string", "pattern": "^iphone(os|simulator)[0-9]+(\\.[0-9]+){0,2}$" },
            "sdk_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
            "minimum_os_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
            "device_families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": [1, 2] } },
            "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arm64", "arm64e", "x86_64", "i386", "armv7", "armv7s"] } },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "privacy_usage_keys": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^NS[A-Za-z0-9]+UsageDescription$" } },
        "app_bundle_signature_state": { "enum": ["unsigned", "adhoc_no_identity"] },
        "signature_inspection": { "const": "codesign_display" },
        "provisioning_profile_present": { "const": false }
      }
    }
  }
}
