{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/agent_adapter.schema.json",
  "title": "エージェントAdapter契約（AgentAdapter）",
  "type": "object",
  "required": [
    "adapter_id",
    "agent_id",
    "provider",
    "version",
    "model",
    "status",
    "capabilities",
    "workspace_requirements",
    "tool_support",
    "mcp_support",
    "session_support",
    "cancellation_support",
    "usage_metrics_support",
    "cost_metrics_support",
    "authentication",
    "host_requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ready", "degraded", "unavailable", "unsupported"]},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "support"],
        "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "support": {"$ref": "#/$defs/support"}
        }
      }
    },
    "workspace_requirements": {
      "type": "object",
      "required": ["mode", "boundary_policy", "secret_paths"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["required", "optional"]},
        "boundary_policy": {"type": "string", "const": "deny_outside_workspace"},
        "secret_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tool_support": {"$ref": "#/$defs/support"},
    "mcp_support": {"$ref": "#/$defs/support"},
    "session_support": {"$ref": "#/$defs/support"},
    "cancellation_support": {"$ref": "#/$defs/support"},
    "usage_metrics_support": {"$ref": "#/$defs/support"},
    "cost_metrics_support": {"$ref": "#/$defs/support"},
    "authentication": {
      "type": "object",
      "required": ["method", "secret_value_present"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["none", "api_key_reference", "oauth_reference", "local_credential_reference", "unsupported", "unknown"]
        },
        "secret_value_present": {"type": "boolean", "const": false}
      }
    },
    "host_requirements": {
      "type": "object",
      "required": ["platforms", "network_scope", "process_spawn"],
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["windows", "macos", "linux", "android", "ios", "unknown"]}
        },
        "network_scope": {"type": "string", "enum": ["loopback_only", "outbound_allowed", "unsupported", "unknown"]},
        "process_spawn": {"$ref": "#/$defs/support"}
      }
    }
  },
  "$defs": {
    "support": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["supported", "unsupported", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
