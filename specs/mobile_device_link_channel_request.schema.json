{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mobile_device_link_channel_request.schema.json",
  "title": "Mobile Flutterからnative Device Link transportへの要求",
  "description": "招待・資格・secretはこのchannelを通過しない。権限源は既存Desktop Rust Brokerであり、native adapterはOS保管とTLS transportだけを担う。",
  "type": "object",
  "required": [
    "version",
    "method"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "read_state",
        "read_recovery_audit",
        "pair",
        "broker_request",
        "disconnect",
        "local_delete"
      ]
    },
    "broker_operation": {
      "type": "string",
      "enum": [
        "実行系列挙",
        "Agent一覧",
        "作業領域一覧",
        "対話開始",
        "対話送信",
        "対話取得",
        "対話中止",
        "対話終了",
        "実行系ライフサイクル状態",
        "実行系資源観測",
        "通知一覧",
        "全Runtime停止要求",
        "対話履歴閲覧状態",
        "対話履歴閲覧"
      ]
    },
    "payload": {}
  },
  "$defs": {
    "safe_value": {
      "anyOf": [
        {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_value"
          }
        },
        {
          "$ref": "#/$defs/safe_object"
        }
      ]
    },
    "safe_object": {
      "type": "object",
      "propertyNames": {
        "not": {
          "anyOf": [
            {
              "enum": [
                "招待秘密",
                "端末秘密",
                "資格秘密",
                "端末資格",
                "owner",
                "Owner",
                "authority",
                "Authority",
                "permission",
                "Permission",
                "approval",
                "Approval",
                "audit",
                "Audit"
              ]
            },
            {
              "pattern": "[oO][wW][nN][eE][rR]|[aA][uU][tT][hH][oO][rR][iI][tT][yY]|[pP][eE][rR][mM][iI][sS][sS][iI][oO][nN]|[aA][pP][pP][rR][oO][vV][aA][lL]|[aA][uU][dD][iI][tT]"
            },
            {
              "pattern": "[\\s\\S]*[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*[sS][eE][cC][rR][eE][tT][\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*[tT][oO][kK][eE][nN][\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*[pP][rR][iI][vV][aA][tT][eE][\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*[pP][aA][sS][sS][wW][oO][rR][dD][\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN][\\s\\S]*"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/safe_value"
      }
    },
    "history_payload": {
      "type": "object",
      "required": ["approval_id", "query"],
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
        },
        "query": { "$ref": "#/$defs/history_query" }
      }
    },
    "history_query": {
      "type": "object",
      "required": ["after", "limit"],
      "additionalProperties": false,
      "properties": {
        "after": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "latest_per_request": { "type": "boolean" },
        "include_audit_context": { "type": "boolean" },
        "include_result_evidence": { "type": "boolean" },
        "include_content_receipt": { "type": "boolean" },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "要求ID": { "type": "string", "pattern": "^[a-f0-9]{32}$(?![\\s\\S])" },
            "対話セッションID": { "type": "string", "pattern": "^[a-f0-9]{32}$(?![\\s\\S])" },
            "実行系ID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])" },
            "状態": { "type": "string", "enum": ["承認待ち", "実行中", "成功", "保留", "失敗", "中止"] }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "version": { "const": 1 },
        "method": { "const": "read_recovery_audit" }
      },
      "required": ["version", "method"],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "read_state"
        }
      },
      "required": [
        "version",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "pair"
        }
      },
      "required": [
        "version",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "broker_request"
        },
        "broker_operation": {
          "enum": [
            "実行系列挙",
            "Agent一覧",
            "対話開始",
            "対話送信",
            "対話取得",
            "対話中止",
            "対話終了",
            "実行系ライフサイクル状態",
            "実行系資源観測",
            "通知一覧",
            "全Runtime停止要求",
            "対話履歴閲覧状態"
          ]
        },
        "payload": {
          "$ref": "#/$defs/safe_object"
        }
      },
      "required": [
        "version",
        "method",
        "broker_operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": { "const": 1 },
        "method": { "const": "broker_request" },
        "broker_operation": { "const": "作業領域一覧" },
        "payload": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "method",
        "broker_operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": { "const": 1 },
        "method": { "const": "broker_request" },
        "broker_operation": { "const": "対話履歴閲覧" },
        "payload": { "$ref": "#/$defs/history_payload" }
      },
      "required": [
        "version",
        "method",
        "broker_operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "disconnect"
        }
      },
      "required": [
        "version",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "local_delete"
        }
      },
      "required": [
        "version",
        "method"
      ],
      "additionalProperties": false
    }
  ]
}
