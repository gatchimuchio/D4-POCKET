{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/credential_deletion_request.schema.json",
  "title": "資格情報削除要求",
  "description": "失効済みCredential一件のNative Vault itemを削除するOwner確認要求。登録・失効・削除のAudit metadataを保持し、秘密値、Authority、Permission、Approvalを受け付けない。削除途中からの再開は同じID・hashへの新しいOwner確認だけで行う。",
  "type": "object",
  "required": ["版", "資格情報ID", "用途", "接続対象", "暗号文hash", "作成監査ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "資格情報ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "用途": { "type": "string", "minLength": 1, "maxLength": 256 },
    "接続対象": { "type": "string", "minLength": 1, "maxLength": 256 },
    "暗号文hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "作成監査ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
