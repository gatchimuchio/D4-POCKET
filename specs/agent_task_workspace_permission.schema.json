{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/agent_task_workspace_permission.schema.json",
  "title": "Broker発行Agent Task用Workspace Permission",
  "type": "object",
  "required": [
    "permission_id",
    "agent_runtime_id",
    "session_id",
    "workspace_id",
    "workspace_registration_hash",
    "operation",
    "scope",
    "decision",
    "source",
    "expires_at_epoch_seconds",
    "use_limit",
    "uses_remaining",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "permission_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "agent_runtime_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "workspace_registration_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "operation": {"const": "agent_task.execute"},
    "scope": {"const": "session_workspace_once"},
    "decision": {"const": "allow"},
    "source": {"const": "owner"},
    "expires_at_epoch_seconds": {"type": "integer", "minimum": 1},
    "use_limit": {"const": 1},
    "uses_remaining": {"type": "integer", "enum": [0, 1]},
    "status": {"type": "string", "enum": ["active", "consumed", "revoked", "expired"]}
  }
}
