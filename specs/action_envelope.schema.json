{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/action_envelope.schema.json",
  "title": "ActionEnvelope",
  "type": "object",
  "required": [
    "envelope_id",
    "runtime_id",
    "operation",
    "capability_id",
    "permission_id",
    "approval_id",
    "recovery_id",
    "target_scope",
    "payload_hash",
    "authority_source",
    "audit_event_required"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "permission_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "recovery_id": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "authority_source": {
      "type": "string",
      "enum": [
        "broker_internal",
        "user",
        "policy",
        "runtime"
      ]
    },
    "audit_event_required": {
      "type": "boolean",
      "const": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
