{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/gui_shell_module_comparison_evidence.schema.json",
  "title": "開発用GUI Shell画面Module比較build証拠 v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidence_type",
    "evidence_source",
    "product_artifact_claimed",
    "standalone_app_claimed",
    "selection_input_trust",
    "authority_verified",
    "source_commit",
    "source_receipt_sha256",
    "worktree_clean",
    "target_platform",
    "build_mode",
    "build_scope",
    "same_source_commit",
    "same_toolchain",
    "toolchain",
    "catalog_version",
    "selection_mode",
    "requested_optional_module_ids",
    "included_module_ids",
    "excluded_optional_module_ids",
    "baseline_selection",
    "baseline",
    "selected",
    "pruning_variants",
    "comparison",
    "rust_binary_comparison",
    "resource_inventory_comparison",
    "package_dependency_comparison",
    "binary_pruning_verified",
    "semantic_pruning_status",
    "cold_start_status",
    "resource_comparison_status",
    "signed"
  ],
  "properties": {
    "version": { "const": 5 },
    "evidence_type": { "const": "development_module_build_comparison" },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "product_artifact_claimed": { "const": false },
    "standalone_app_claimed": { "const": false },
    "selection_input_trust": { "const": "unverified_receipt_json_selection_only" },
    "authority_verified": { "const": false },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "worktree_clean": { "const": true },
    "target_platform": { "const": "windows" },
    "build_mode": { "const": "release" },
    "build_scope": { "const": "desktop_flutter_rust_helper_and_launcher" },
    "same_source_commit": { "const": true },
    "same_toolchain": { "const": true },
    "toolchain": {
      "type": "object",
      "required": ["flutter", "dart", "framework_revision"],
      "additionalProperties": false,
      "properties": {
        "flutter": { "type": "string", "minLength": 1 },
        "dart": { "type": "string", "minLength": 1 },
        "framework_revision": { "type": "string", "minLength": 1 }
      }
    },
    "catalog_version": { "const": 1 },
    "selection_mode": { "enum": ["all_optional", "explicit_optional"] },
    "requested_optional_module_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/optional_module_id" }
    },
    "included_module_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/module_id" }
    },
    "excluded_optional_module_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/optional_module_id" }
    },
    "baseline_selection": { "const": "all_optional_default_enabled" },
    "baseline": {
      "allOf": [
        { "$ref": "#/$defs/build_run" },
        {
          "properties": {
            "label": { "const": "baseline" },
            "artifact_root": { "const": "baseline/app" },
            "dart_define_arguments": { "const": {} },
            "effective_dart_defines": { "$ref": "#/$defs/all_enabled_defines" },
            "build_command": { "not": { "contains": { "pattern": "^--dart-define=" } } }
          }
        }
      ]
    },
    "selected": {
      "allOf": [
        { "$ref": "#/$defs/build_run" },
        {
          "properties": {
            "label": { "const": "selected" },
            "artifact_root": { "const": "selected/app" },
            "build_command": {
              "contains": { "pattern": "^--dart-define=GUI_SHELL_MODULE_" }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_total_bytes",
        "selected_total_bytes",
        "total_bytes_reduced",
        "baseline_app_code_bytes",
        "selected_app_code_bytes",
        "app_code_bytes_reduced",
        "baseline_app_code_sha256",
        "selected_app_code_sha256",
        "changed_artifact_paths",
        "non_aot_changed_artifact_paths",
        "non_aot_artifacts_identical"
      ],
      "properties": {
        "baseline_total_bytes": { "type": "integer", "minimum": 1 },
        "selected_total_bytes": { "type": "integer", "minimum": 1 },
        "total_bytes_reduced": { "type": "integer" },
        "baseline_app_code_bytes": { "type": "integer", "minimum": 1 },
        "selected_app_code_bytes": { "type": "integer", "minimum": 1 },
        "app_code_bytes_reduced": { "type": "integer" },
        "baseline_app_code_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selected_app_code_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changed_artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_artifact_path" }
        },
        "non_aot_changed_artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_artifact_path" }
        },
        "non_aot_artifacts_identical": { "type": "boolean" }
      }
    },
    "rust_binary_comparison": {
      "$ref": "#/$defs/rust_binary_comparison"
    },
    "resource_inventory_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_resource_bytes",
        "selected_resource_bytes",
        "changed_resource_paths",
        "resource_inventory_identical"
      ],
      "properties": {
        "baseline_resource_bytes": { "type": "integer", "minimum": 0 },
        "selected_resource_bytes": { "type": "integer", "minimum": 0 },
        "changed_resource_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_artifact_path" }
        },
        "resource_inventory_identical": { "type": "boolean" }
      }
    },
    "package_dependency_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_runtime_tree_sha256",
        "selected_runtime_tree_sha256",
        "runtime_package_tree_identical",
        "removed_aot_package_libraries",
        "added_aot_package_libraries"
      ],
      "properties": {
        "baseline_runtime_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selected_runtime_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_package_tree_identical": { "type": "boolean" },
        "removed_aot_package_libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/aot_package_library" }
        },
        "added_aot_package_libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/aot_package_library" }
        }
      }
    },
    "binary_pruning_verified": { "const": false },
    "semantic_pruning_status": {
      "const": "flutter_aot_rust_helper_and_launcher_binaries_observed; standalone_runtime_unverified"
    },
    "cold_start_status": { "const": "not_measured" },
    "resource_comparison_status": { "const": "not_measured" },
    "signed": { "const": false },
    "pruning_variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/pruning_variant"
      }
    }
  },
  "$defs": {
    "rust_symbol_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbol_count"],
      "properties": {
        "file": { "$ref": "#/$defs/symbol_list_file" },
        "symbol_count": { "type": "integer", "minimum": 1 }
      }
    },
    "symbol_list_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_artifact_path" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rust_runtime_dependency_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "entry_count", "tree_file"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "entry_count": { "type": "integer", "minimum": 1 },
        "tree_file": { "$ref": "#/$defs/analysis_file" }
      }
    },
    "rust_helper_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "included_optional_module_ids",
        "cargo_feature_arguments",
        "cargo_command",
        "launcher_cargo_command",
        "build_duration_ms",
        "launcher_build_duration_ms",
        "binary",
        "linker_map",
        "symbol_inventory",
        "launcher_binary",
        "launcher_linker_map",
        "launcher_symbol_inventory",
        "runtime_dependency_tree"
      ],
      "properties": {
        "label": { "enum": ["baseline","selected","no_optional_modules","without_setup_doctor","without_history"] },
        "included_optional_module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/optional_module_id" }
        },
        "cargo_feature_arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cargo_command": {
          "type": "array",
          "minItems": 12,
          "items": { "type": "string", "minLength": 1 }
        },
        "launcher_cargo_command": {
          "type": "array",
          "minItems": 12,
          "items": { "type": "string", "minLength": 1 }
        },
        "build_duration_ms": { "type": "integer", "minimum": 0 },
        "launcher_build_duration_ms": { "type": "integer", "minimum": 0 },
        "binary": { "$ref": "#/$defs/analysis_file" },
        "linker_map": { "$ref": "#/$defs/analysis_file" },
        "symbol_inventory": { "$ref": "#/$defs/rust_symbol_file" },
        "launcher_binary": { "$ref": "#/$defs/analysis_file" },
        "launcher_linker_map": { "$ref": "#/$defs/analysis_file" },
        "launcher_symbol_inventory": { "$ref": "#/$defs/rust_symbol_file" },
        "runtime_dependency_tree": {
          "$ref": "#/$defs/rust_runtime_dependency_tree"
        }
      }
    },
    "rust_binary_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_target",
        "always_included_module_ids",
        "same_source_commit",
        "same_toolchain",
        "toolchain",
        "baseline",
        "selected",
        "pruning_variants",
        "comparison",
        "desktop_launcher_comparison",
        "binary_pruning_verified"
      ],
      "properties": {
        "build_target": { "const": "x86_64-pc-windows-msvc" },
        "always_included_module_ids": {
          "const": [
            "core.security_broker",
            "core.cryptography",
            "core.audit_finality",
            "core.credentials",
            "core.os_controls",
            "core.permission_enforcement",
            "core.approval_enforcement",
            "core.content_exposure",
            "shell.dashboard",
            "shell.runtime_operation",
            "shell.agent_operation",
            "shell.authority",
            "shell.approval",
            "shell.audit",
            "shell.recovery",
            "shell.problems",
            "shell.evidence",
            "shell.settings"
          ]
        },
        "same_source_commit": { "const": true },
        "same_toolchain": { "const": true },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cargo", "rustc", "target"],
          "properties": {
            "cargo": { "type": "string", "minLength": 1 },
            "rustc": { "type": "string", "minLength": 1 },
            "target": { "const": "x86_64-pc-windows-msvc" }
          }
        },
        "baseline": {
          "allOf": [
            { "$ref": "#/$defs/rust_helper_run" },
            {
              "properties": {
                "label": { "const": "baseline" },
                "included_optional_module_ids": {
                  "const": [
                    "shell.setup_doctor",
                    "shell.history",
                    "shell.evaluation_lab",
                    "shell.host_capabilities",
                    "shell.notifications",
                    "shell.observability",
                    "shell.trace_inspector",
                    "shell.host_operations"
                  ]
                }
              }
            }
          ]
        },
        "selected": {
          "allOf": [
            { "$ref": "#/$defs/rust_helper_run" },
            { "properties": { "label": { "const": "selected" } } }
          ]
        },
        "comparison": {
          "$ref": "#/$defs/rust_pair_comparison"
        },
        "desktop_launcher_comparison": {
          "$ref": "#/$defs/rust_pair_comparison"
        },
        "binary_pruning_verified": { "const": false },
        "pruning_variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/rust_pruning_variant"
          }
        }
      }
    },
    "optional_module_id": {
      "enum": [
        "shell.setup_doctor",
        "shell.history",
        "shell.evaluation_lab",
        "shell.host_capabilities",
        "shell.notifications",
        "shell.observability",
        "shell.trace_inspector",
        "shell.host_operations"
      ]
    },
    "module_id": {
      "enum": [
        "core.security_broker",
        "core.cryptography",
        "core.audit_finality",
        "core.credentials",
        "core.os_controls",
        "core.permission_enforcement",
        "core.approval_enforcement",
        "core.content_exposure",
        "shell.dashboard",
        "shell.runtime_operation",
        "shell.agent_operation",
        "shell.authority",
        "shell.approval",
        "shell.audit",
        "shell.recovery",
        "shell.problems",
        "shell.evidence",
        "shell.settings",
        "shell.setup_doctor",
        "shell.history",
        "shell.evaluation_lab",
        "shell.host_capabilities",
        "shell.notifications",
        "shell.observability",
        "shell.trace_inspector",
        "shell.host_operations"
      ]
    },
    "define_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GUI_SHELL_MODULE_SETUP_DOCTOR": { "type": "boolean" },
        "GUI_SHELL_MODULE_HISTORY": { "type": "boolean" },
        "GUI_SHELL_MODULE_EVALUATION_LAB": { "type": "boolean" },
        "GUI_SHELL_MODULE_HOST_CAPABILITIES": { "type": "boolean" },
        "GUI_SHELL_MODULE_NOTIFICATIONS": { "type": "boolean" },
        "GUI_SHELL_MODULE_OBSERVABILITY": { "type": "boolean" },
        "GUI_SHELL_MODULE_TRACE_INSPECTOR": { "type": "boolean" },
        "GUI_SHELL_MODULE_HOST_OPERATIONS": { "type": "boolean" }
      }
    },
    "all_enabled_defines": {
      "type": "object",
      "required": [
        "GUI_SHELL_MODULE_SETUP_DOCTOR",
        "GUI_SHELL_MODULE_HISTORY",
        "GUI_SHELL_MODULE_EVALUATION_LAB",
        "GUI_SHELL_MODULE_HOST_CAPABILITIES",
        "GUI_SHELL_MODULE_NOTIFICATIONS",
        "GUI_SHELL_MODULE_OBSERVABILITY",
        "GUI_SHELL_MODULE_TRACE_INSPECTOR",
        "GUI_SHELL_MODULE_HOST_OPERATIONS"
      ],
      "properties": {
        "GUI_SHELL_MODULE_SETUP_DOCTOR": { "const": true },
        "GUI_SHELL_MODULE_HISTORY": { "const": true },
        "GUI_SHELL_MODULE_EVALUATION_LAB": { "const": true },
        "GUI_SHELL_MODULE_HOST_CAPABILITIES": { "const": true },
        "GUI_SHELL_MODULE_NOTIFICATIONS": { "const": true },
        "GUI_SHELL_MODULE_OBSERVABILITY": { "const": true },
        "GUI_SHELL_MODULE_TRACE_INSPECTOR": { "const": true },
        "GUI_SHELL_MODULE_HOST_OPERATIONS": { "const": true }
      },
      "additionalProperties": false
    },
    "relative_artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "artifact_file": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relative_artifact_path" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "aot_package_library": {
      "type": "string",
      "pattern": "^package:[A-Za-z0-9_.-]+(?:/.*)?$"
    },
    "runtime_dependency_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "dependencies"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime_dependency_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "command",
        "root_package",
        "direct_runtime_dependencies",
        "runtime_packages",
        "runtime_package_count",
        "runtime_tree_sha256"
      ],
      "properties": {
        "source": { "const": "dart_pub_deps_json" },
        "command": { "const": "dart pub deps --json" },
        "root_package": { "type": "string", "minLength": 1 },
        "direct_runtime_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "runtime_packages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtime_dependency_package" }
        },
        "runtime_package_count": { "type": "integer", "minimum": 1 },
        "runtime_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "analysis_file": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relative_artifact_path" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "build_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "dart_define_arguments",
        "effective_dart_defines",
        "build_command",
        "build_duration_ms",
        "artifact_root",
        "artifact_files",
        "artifact_total_bytes",
        "artifact_tree_sha256",
        "aot_surface_libraries",
        "aot_package_libraries",
        "runtime_dependency_tree",
        "size_analysis_report",
        "size_analysis_inputs"
      ],
      "properties": {
        "label": { "enum": ["baseline","selected","no_optional_modules","without_setup_doctor","without_history"] },
        "dart_define_arguments": { "$ref": "#/$defs/define_map" },
        "effective_dart_defines": {
          "type": "object",
          "required": [
            "GUI_SHELL_MODULE_SETUP_DOCTOR",
            "GUI_SHELL_MODULE_HISTORY",
            "GUI_SHELL_MODULE_EVALUATION_LAB",
            "GUI_SHELL_MODULE_HOST_CAPABILITIES",
            "GUI_SHELL_MODULE_NOTIFICATIONS",
            "GUI_SHELL_MODULE_OBSERVABILITY",
            "GUI_SHELL_MODULE_TRACE_INSPECTOR",
            "GUI_SHELL_MODULE_HOST_OPERATIONS"
          ],
          "additionalProperties": false,
          "properties": {
            "GUI_SHELL_MODULE_SETUP_DOCTOR": { "type": "boolean" },
            "GUI_SHELL_MODULE_HISTORY": { "type": "boolean" },
            "GUI_SHELL_MODULE_EVALUATION_LAB": { "type": "boolean" },
            "GUI_SHELL_MODULE_HOST_CAPABILITIES": { "type": "boolean" },
            "GUI_SHELL_MODULE_NOTIFICATIONS": { "type": "boolean" },
            "GUI_SHELL_MODULE_OBSERVABILITY": { "type": "boolean" },
            "GUI_SHELL_MODULE_TRACE_INSPECTOR": { "type": "boolean" },
            "GUI_SHELL_MODULE_HOST_OPERATIONS": { "type": "boolean" }
          }
        },
        "build_command": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "build_duration_ms": { "type": "integer", "minimum": 0 },
        "artifact_root": { "$ref": "#/$defs/relative_artifact_path" },
        "artifact_files": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact_file" }
        },
        "artifact_total_bytes": { "type": "integer", "minimum": 1 },
        "artifact_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "aot_surface_libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "aot_package_libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/aot_package_library" }
        },
        "runtime_dependency_tree": { "$ref": "#/$defs/runtime_dependency_tree" },
        "size_analysis_report": { "$ref": "#/$defs/analysis_file" },
        "size_analysis_inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/analysis_file" }
        }
      }
    },
    "pruning_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "omitted_optional_module_ids",
        "included_optional_module_ids",
        "excluded_optional_module_ids",
        "run",
        "comparison_to_baseline",
        "resource_inventory_comparison_to_baseline",
        "package_dependency_comparison_to_baseline"
      ],
      "properties": {
        "label": {
          "enum": [
            "no_optional_modules",
            "without_setup_doctor",
            "without_history"
          ]
        },
        "omitted_optional_module_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optional_module_id"
          }
        },
        "included_optional_module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optional_module_id"
          }
        },
        "excluded_optional_module_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optional_module_id"
          }
        },
        "run": {
          "allOf": [
            {
              "$ref": "#/$defs/build_run"
            },
            {
              "properties": {
                "artifact_root": {
                  "pattern": "^(no_optional_modules|without_[a-z0-9_]+)/app$"
                }
              }
            }
          ]
        },
        "comparison_to_baseline": {
          "$ref": "#/properties/comparison"
        },
        "resource_inventory_comparison_to_baseline": {
          "$ref": "#/properties/resource_inventory_comparison"
        },
        "package_dependency_comparison_to_baseline": {
          "$ref": "#/properties/package_dependency_comparison"
        }
      }
    },
    "rust_pruning_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "omitted_optional_module_ids",
        "included_optional_module_ids",
        "run",
        "comparison_to_baseline",
        "desktop_launcher_comparison_to_baseline"
      ],
      "properties": {
        "label": {
          "enum": [
            "no_optional_modules",
            "without_setup_doctor",
            "without_history"
          ]
        },
        "omitted_optional_module_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optional_module_id"
          }
        },
        "included_optional_module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optional_module_id"
          }
        },
        "run": {
          "$ref": "#/$defs/rust_helper_run"
        },
        "comparison_to_baseline": {
          "$ref": "#/$defs/rust_pair_comparison"
        },
        "desktop_launcher_comparison_to_baseline": {
          "$ref": "#/$defs/rust_pair_comparison"
        }
      }
    },
    "rust_pair_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_binary_bytes",
        "selected_binary_bytes",
        "binary_bytes_reduced",
        "baseline_binary_sha256",
        "selected_binary_sha256",
        "binary_hash_changed",
        "runtime_dependency_tree_identical",
        "removed_symbol_count",
        "added_symbol_count",
        "removed_symbols_file",
        "added_symbols_file"
      ],
      "properties": {
        "baseline_binary_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "selected_binary_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "binary_bytes_reduced": {
          "type": "integer"
        },
        "baseline_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_hash_changed": {
          "type": "boolean"
        },
        "runtime_dependency_tree_identical": {
          "type": "boolean"
        },
        "removed_symbol_count": {
          "type": "integer",
          "minimum": 0
        },
        "added_symbol_count": {
          "type": "integer",
          "minimum": 0
        },
        "removed_symbols_file": {
          "$ref": "#/$defs/symbol_list_file"
        },
        "added_symbols_file": {
          "$ref": "#/$defs/symbol_list_file"
        }
      }
    }
  }
}
