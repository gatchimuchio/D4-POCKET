{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/evaluation_dataset_registration.schema.json",
  "title": "評価Dataset owner登録payload",
  "description": "owner control経路だけが扱うprivate入力。評価DatasetID内では既存の確定revisionより大きいrevisionだけを登録し、同じ(ID, revision)を再登録してはならない。永続履歴との順序比較は標準JSON Schema単独では表せないためtooling/evaluation_contract_check.pyとBrokerがfail-closedに検査する。normal IPCまたは公開manifestへ返してはならず、Authority、Permission、Approval、Audit、release/security決定を生成しない。",
  "type": "object",
  "required": [
    "版",
    "評価DatasetID",
    "revision",
    "公開表示名",
    "登録者種別",
    "登録経路",
    "評価用途",
    "評価方式",
    "非公開CasePayload一覧"
  ],
  "additionalProperties": false,
  "properties": {
    "版": {
      "const": 1
    },
    "評価DatasetID": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "同一評価DatasetID内で既存の確定revisionより大きいimmutable revision。"
    },
    "公開表示名": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "登録者種別": {
      "const": "owner"
    },
    "登録経路": {
      "const": "owner_control"
    },
    "評価用途": {
      "const": "運用観測"
    },
    "評価方式": {
      "const": "決定論"
    },
    "非公開CasePayload一覧": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/private_case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "kind": {
      "type": "string",
      "enum": [
        "exact",
        "contains",
        "regex",
        "json_schema",
        "reference_count",
        "route",
        "status",
        "capability",
        "latency_threshold"
      ]
    },
    "private_case": {
      "type": "object",
      "required": [
        "評価CaseID",
        "順序",
        "公開表示名",
        "入力",
        "評価器設定"
      ],
      "additionalProperties": false,
      "properties": {
        "評価CaseID": {
          "$ref": "#/$defs/id"
        },
        "順序": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "公開表示名": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "入力": {
          "type": "object",
          "required": [
            "内容表示範囲",
            "本文"
          ],
          "additionalProperties": false,
          "properties": {
            "内容表示範囲": {
              "const": "full"
            },
            "本文": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "評価器設定": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/private_evaluator"
          }
        }
      }
    },
    "private_evaluator": {
      "type": "object",
      "required": [
        "評価器ID",
        "種類",
        "設定"
      ],
      "additionalProperties": false,
      "properties": {
        "評価器ID": {
          "$ref": "#/$defs/id"
        },
        "種類": {
          "$ref": "#/$defs/kind"
        },
        "設定": {
          "oneOf": [
            {
              "$ref": "#/$defs/exact_config"
            },
            {
              "$ref": "#/$defs/contains_config"
            },
            {
              "$ref": "#/$defs/regex_config"
            },
            {
              "$ref": "#/$defs/json_schema_config"
            },
            {
              "$ref": "#/$defs/reference_count_config"
            },
            {
              "$ref": "#/$defs/route_config"
            },
            {
              "$ref": "#/$defs/status_config"
            },
            {
              "$ref": "#/$defs/capability_config"
            },
            {
              "$ref": "#/$defs/latency_threshold_config"
            }
          ]
        }
      }
    },
    "exact_config": {
      "type": "object",
      "required": [
        "期待本文"
      ],
      "additionalProperties": false,
      "properties": {
        "期待本文": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "contains_config": {
      "type": "object",
      "required": [
        "期待断片"
      ],
      "additionalProperties": false,
      "properties": {
        "期待断片": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "regex_config": {
      "type": "object",
      "required": [
        "パターン"
      ],
      "additionalProperties": false,
      "properties": {
        "パターン": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "json_schema_config": {
      "type": "object",
      "required": [
        "期待Schema"
      ],
      "additionalProperties": false,
      "properties": {
        "期待Schema": {
          "type": "object"
        }
      }
    },
    "reference_count_config": {
      "type": "object",
      "required": [
        "最小数",
        "最大数"
      ],
      "additionalProperties": false,
      "properties": {
        "最小数": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "最大数": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "route_config": {
      "type": "object",
      "required": [
        "期待経路"
      ],
      "additionalProperties": false,
      "properties": {
        "期待経路": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "status_config": {
      "type": "object",
      "required": [
        "期待状態"
      ],
      "additionalProperties": false,
      "properties": {
        "期待状態": {
          "type": "string",
          "enum": [
            "成功",
            "保留",
            "失敗",
            "中止"
          ]
        }
      }
    },
    "capability_config": {
      "type": "object",
      "required": [
        "必要能力一覧"
      ],
      "additionalProperties": false,
      "properties": {
        "必要能力一覧": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "latency_threshold_config": {
      "type": "object",
      "required": [
        "最大Millis"
      ],
      "additionalProperties": false,
      "properties": {
        "最大Millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    }
  }
}
