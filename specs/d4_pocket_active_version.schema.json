{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/d4_pocket_active_version.schema.json",
  "title": "D4 Pocket有効版記録",
  "description": "固定導入rootのBootstrapperが起動対象を導出するためのBroker生成記録。Authorityを含まない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "product",
    "app_id",
    "audit_store_id",
    "product_version",
    "package_sha256",
    "launcher_sha256",
    "product_manifest_sha256"
  ],
  "properties": {
    "version": { "const": 1 },
    "product": { "const": "D4 Pocket" },
    "app_id": { "type": "string", "pattern": "^d4-pocket-app-[a-f0-9]{32}$" },
    "audit_store_id": { "type": "string", "pattern": "^audit-store-[a-f0-9]{32}$" },
    "product_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "allOf": [{ "pattern": "[0-9]" }]
    },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "launcher_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "product_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
