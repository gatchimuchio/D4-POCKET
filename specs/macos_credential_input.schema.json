{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/macos_credential_input.schema.json",
  "title": "macOS資格情報native入力要求",
  "description": "資格情報登録の公開UI要求。秘密値・保管先・Owner資格を含めず、Rust native入力後の別個Owner確認だけが既存登録payloadを作る。",
  "type": "object",
  "additionalProperties": false,
  "required": ["版", "資格情報ID", "用途", "接続対象", "種類"],
  "properties": {
    "版": {"const": 1},
    "資格情報ID": {"type":"string", "pattern":"^[a-f0-9]{32}$(?![\\s\\S])"},
    "用途": {"enum":["mcp_connection_secret", "provider_api_key"]},
    "接続対象": {"type":"string", "minLength":1, "maxLength":256, "pattern":"^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"},
    "種類": {"const":"api_key"}
  }
}
