{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/device_link_credential.schema.json",
  "title": "端末結合資格の安全保管値",
  "description": "端末連携の意味は docs/specs/device-link.md を正本とする。構造適合は資格・権限・期限・所有関係の証拠ではない。",
  "type": "object",
  "required": [
    "版",
    "HostID",
    "接続先Host",
    "port",
    "証明書hash",
    "端末ID",
    "有効期限",
    "結合ID",
    "端末秘密"
  ],
  "additionalProperties": false,
  "properties": {
    "版": {
      "type": "integer",
      "const": 1
    },
    "HostID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "接続先Host": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$(?![\\s\\S])"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "証明書hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "端末ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "有効期限": {
      "type": "integer",
      "minimum": 1
    },
    "結合ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "端末秘密": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    }
  }
}
