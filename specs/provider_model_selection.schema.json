{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/provider_model_selection.schema.json",
  "title": "Provider・Model選択",
  "description": "実物の独立CLI Adapter経路で選ぶProviderとModel。Codex CLIはCLI管理認証またはBroker保管庫参照、Claude Code CLIはCLI管理認証に固定する。資格情報の実値・権限・Capabilityは含めず、自動fallbackは行わない。",
  "type": "object",
  "required": ["version", "provider_id", "model_id", "authentication_source", "automatic_fallback"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "provider_id": {"enum": ["openai_codex_cli", "anthropic_claude_code_cli"]},
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$(?![\\s\\S])",
      "description": "選択した実CLIへ--modelで渡す値。存在・契約・利用可能性は登録時に推測しない。"
    },
    "authentication_source": {"enum": ["codex_cli_managed", "broker_credential_vault", "claude_code_cli_managed"]},
    "credential_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])",
      "description": "BrokerのOS別資格情報保管庫にあるprovider_api_key資格情報への公開メタデータ参照。WindowsではDPAPI、LinuxではSecret Service、macOSではKeychainを使う。秘密値ではなく、Brokerが登録時・使用時に用途、対象、状態を再検証する。"
    },
    "automatic_fallback": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"authentication_source": {"const": "codex_cli_managed"}}},
      "then": {"not": {"required": ["credential_id"]}}
    },
    {
      "if": {"properties": {"authentication_source": {"const": "broker_credential_vault"}}},
      "then": {"required": ["credential_id"]}
    },
    {
      "if": {"properties": {"authentication_source": {"const": "claude_code_cli_managed"}}},
      "then": {
        "properties": {"provider_id": {"const": "anthropic_claude_code_cli"}},
        "not": {"required": ["credential_id"]}
      }
    },
    {
      "if": {"properties": {"authentication_source": {"enum": ["codex_cli_managed", "broker_credential_vault"]}}},
      "then": {"properties": {"provider_id": {"const": "openai_codex_cli"}}}
    }
  ]
}
