{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/gui_shell_edit_proposal_receipt.schema.json",
  "title": "GUI Shell編集提案応答",
  "type": "object",
  "required": ["version", "operation", "status", "edit_id", "scope", "target_paths", "execution_mode", "review_required", "apply_status", "files_written", "permission_generated", "approval_state", "authority_strip", "evidence_source", "instruction_hash", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "operation": { "const": "GUI Shell編集提案" },
    "status": { "const": "accepted" },
    "edit_id": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["composition", "ui", "contract"] },
    "target_paths": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
    "expected_change_count": { "type": "integer", "minimum": 1, "maximum": 32 },
    "execution_mode": { "const": "proposal_only" },
    "review_required": { "const": true },
    "apply_status": { "const": "not_started" },
    "files_written": { "const": false },
    "permission_generated": { "const": false },
    "approval_state": { "const": "owner_review_required" },
    "authority_strip": { "const": true },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "instruction_hash": { "type": "string", "minLength": 1 },
    "audit_id": { "type": "string", "minLength": 1 }
  }
}
