{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/adapter_management_manifest.schema.json",
  "title": "アダプター管理マニフェスト（AdapterManagementManifest）",
  "type": "object",
  "required": [
    "版",
    "Adapter ID",
    "Runtime ID",
    "発行者",
    "source",
    "version",
    "transport",
    "Content Exposure",
    "要求Capability",
    "許可差分",
    "既知の危険",
    "互換性",
    "authority_strip",
    "signed_manifest",
    "署名対象",
    "署名",
    "署名者fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "Adapter ID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "Runtime ID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "発行者": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": { "enum": ["owner_manifest", "local_bundle", "builtin"] },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,128}$" },
    "transport": { "enum": ["http", "stdio", "ipc", "mock"] },
    "Content Exposure": { "type": "string", "enum": ["none", "hash_only", "summary", "redacted", "full"] },
    "要求Capability": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "許可差分": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "既知の危険": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "互換性": { "enum": ["compatible", "incompatible", "unknown"] },
    "authority_strip": { "const": true },
    "signed_manifest": { "const": true },
    "署名対象": { "type": "string", "pattern": "^[a-f0-9]{2,131072}$" },
    "署名": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "署名者fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
