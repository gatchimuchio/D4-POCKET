{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/credential_list.schema.json",
  "title": "資格情報公開一覧",
  "description": "通常IPCへ返す資格情報metadataの一覧。秘密値を含めず、ProtectedStoreの実file整合性を確認できた場合だけ全体を返す。",
  "type": "object",
  "required": ["版", "資格情報一覧", "件数", "公開範囲", "証拠種別"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "資格情報一覧": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "credential_receipt.schema.json" }
    },
    "件数": { "type": "integer", "minimum": 0, "maximum": 256 },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" }
  }
}
