{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/a2a_contract.schema.json",
  "title": "A2A外部概念射影契約（A2A Contract）",
  "description": "A2A Agent Card、Task、Message、Artifact、Streamをmetadata_onlyで射影する。外部Agentの宣言はAuthority、Permission、Approval、Trustを生成しない。",
  "type": "object",
  "required": [
    "版",
    "契約種別",
    "protocol_version",
    "Agent Card",
    "Task",
    "Message",
    "Artifact",
    "Stream",
    "Trust",
    "Capability diff",
    "権限生成",
    "authority_strip",
    "公開範囲",
    "証拠種別"
  ],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "契約種別": { "const": "A2A外部概念射影" },
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "Agent Card": { "$ref": "#/$defs/agent_card" },
    "Task": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/task" }
    },
    "Message": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/message" }
    },
    "Artifact": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "Stream": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/stream" }
    },
    "Trust": { "$ref": "#/$defs/trust" },
    "Capability diff": { "$ref": "#/$defs/capability_diff" },
    "権限生成": { "const": "なし" },
    "authority_strip": { "const": true },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "$ref": "#/$defs/evidence_source" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "summary": {
      "type": "string",
      "maxLength": 1024
    },
    "evidence_source": {
      "type": "string",
      "enum": ["CONFIG", "INTERNAL_STATE", "LIVE_RUNTIME", "EXTERNAL_EVIDENCE", "FIXTURE"]
    },
    "support": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["supported", "unsupported", "unknown"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "credential_ref": {
      "type": "object",
      "required": ["credential_id", "purpose", "target", "required", "status"],
      "additionalProperties": false,
      "properties": {
        "credential_id": { "type": "string", "pattern": "^[a-f0-9]{32}$(?![\\s\\S])" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" },
        "status": { "enum": ["configured", "missing", "revoked", "unknown"] }
      }
    },
    "agent_card": {
      "type": "object",
      "required": [
        "agent_id",
        "display_name",
        "description_summary",
        "version",
        "endpoint_hash",
        "supported_interfaces",
        "capabilities",
        "skills",
        "authentication",
        "origin",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description_summary": { "$ref": "#/$defs/summary" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "endpoint_hash": { "$ref": "#/$defs/hash" },
        "supported_interfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["binding", "transport", "status", "reason"],
            "additionalProperties": false,
            "properties": {
              "binding": { "enum": ["jsonrpc", "grpc", "http_rest", "unknown"] },
              "transport": { "enum": ["https", "http", "unknown"] },
              "status": { "enum": ["supported", "unsupported", "unknown"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": ["streaming", "push_notifications", "state_transition_history", "extended_agent_card"],
          "additionalProperties": false,
          "properties": {
            "streaming": { "type": "boolean" },
            "push_notifications": { "type": "boolean" },
            "state_transition_history": { "type": "boolean" },
            "extended_agent_card": { "type": "boolean" }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["skill_id", "name", "description_summary", "tags", "input_modes", "output_modes"],
            "additionalProperties": false,
            "properties": {
              "skill_id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "description_summary": { "$ref": "#/$defs/summary" },
              "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
              "input_modes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
              "output_modes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
            }
          }
        },
        "authentication": {
          "type": "object",
          "required": ["schemes", "credential_ref", "secret_value_present"],
          "additionalProperties": false,
          "properties": {
            "schemes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "credential_ref": { "$ref": "#/$defs/credential_ref" },
            "secret_value_present": { "const": false }
          }
        },
        "origin": { "enum": ["agent_card", "owner_configuration", "live_runtime", "fixture"] },
        "status": { "enum": ["discovered", "unavailable", "quarantined", "unknown"] }
      }
    },
    "task": {
      "type": "object",
      "required": ["task_id", "context_id", "status", "message_ids", "artifact_ids", "history_visibility", "authority_strip"],
      "additionalProperties": false,
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "context_id": { "type": ["string", "null"], "maxLength": 128 },
        "status": { "enum": ["submitted", "working", "input-required", "completed", "canceled", "failed", "rejected", "auth-required", "unknown"] },
        "message_ids": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
        "artifact_ids": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
        "history_visibility": { "const": "metadata_only" },
        "authority_strip": { "const": true }
      }
    },
    "message": {
      "type": "object",
      "required": ["message_id", "task_id", "context_id", "role", "part_kinds", "part_count", "parts_hash", "content_visibility", "status", "authority_strip"],
      "additionalProperties": false,
      "properties": {
        "message_id": { "$ref": "#/$defs/id" },
        "task_id": { "type": ["string", "null"], "maxLength": 128 },
        "context_id": { "type": ["string", "null"], "maxLength": 128 },
        "role": { "enum": ["user", "agent"] },
        "part_kinds": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "enum": ["text", "file", "data", "unknown"] } },
        "part_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "parts_hash": { "$ref": "#/$defs/hash" },
        "content_visibility": { "enum": ["none", "hash_only", "summary", "redacted"] },
        "status": { "enum": ["received", "queued", "processed", "unknown"] },
        "authority_strip": { "const": true }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "task_id", "name", "part_kinds", "part_count", "parts_hash", "content_visibility", "status", "authority_strip"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "part_kinds": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "enum": ["text", "file", "data", "unknown"] } },
        "part_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "parts_hash": { "$ref": "#/$defs/hash" },
        "content_visibility": { "enum": ["none", "hash_only", "summary", "redacted"] },
        "status": { "enum": ["declared", "streaming", "completed", "unknown"] },
        "authority_strip": { "const": true }
      }
    },
    "stream": {
      "type": "object",
      "required": ["stream_id", "task_id", "mode", "status", "event_types", "resumable", "authority_strip"],
      "additionalProperties": false,
      "properties": {
        "stream_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["sse", "websocket", "grpc", "polling", "unsupported", "unknown"] },
        "status": { "$ref": "#/$defs/support" },
        "event_types": { "type": "array", "maxItems": 16, "items": { "enum": ["task_status_update", "artifact_update", "message_update", "unknown"] } },
        "resumable": { "type": "boolean" },
        "authority_strip": { "const": true }
      }
    },
    "trust": {
      "type": "object",
      "required": ["state", "evidence_source", "reason", "requires_operator_review"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["unverified", "pending_review", "verified", "quarantined", "rejected"] },
        "evidence_source": { "$ref": "#/$defs/evidence_source" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requires_operator_review": { "type": "boolean" }
      }
    },
    "capability_diff": {
      "type": "object",
      "required": ["status", "added", "removed", "changed", "requires_operator_review", "evidence_source"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["not_evaluated", "no_change", "added", "removed", "changed", "unknown"] },
        "added": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "removed": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "changed": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "requires_operator_review": { "type": "boolean" },
        "evidence_source": { "$ref": "#/$defs/evidence_source" }
      }
    }
  }
}
