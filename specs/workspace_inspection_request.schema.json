{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/workspace_inspection_request.schema.json",
  "title": "作業領域検査要求",
  "$defs": {
    "editApplyFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["path", "before_hash", "after_hash"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 200},
          "before_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
          "after_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "editApplyTargetRequest": {
      "type": "object",
      "required": [
        "version", "review_audit_id", "review_binding", "workspace_id",
        "registration_hash", "approval_id"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "review_audit_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "review_binding": {"$ref": "#/$defs/editApplyBinding"},
        "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "registration_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}
      }
    },
    "editApplyRequest": {
      "type": "object",
      "required": ["version", "target_audit_id", "target_request"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "target_audit_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "target_request": {"$ref": "#/$defs/editApplyTargetRequest"}
      }
    },
    "rollbackCandidatesRequest": {
      "type": "object",
      "required": ["version", "workspace_id", "registration_hash", "approval_id"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "registration_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "cursor": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "editApplyBinding": {
      "type": "object",
      "required": [
        "proposal_id", "diff_hash", "workspace_id", "registration_hash",
        "approval_id", "expires_at", "baseline_hash", "files"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "diff_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "registration_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "expires_at": {"type": "integer", "minimum": 1},
        "baseline_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "files": {"$ref": "#/$defs/editApplyFiles"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["operation", "payload"],
      "additionalProperties": false,
      "properties": {
        "operation": {"const": "GUI Shell編集適用"},
        "payload": {
          "type": "object",
          "required": [
            "version", "target_audit_id", "target_request"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {"const": 1},
            "target_audit_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
            "target_request": {"$ref": "#/$defs/editApplyTargetRequest"}
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["operation", "payload"],
      "additionalProperties": false,
      "properties": {
        "operation": {"const": "GUI Shell編集Rollback候補一覧"},
        "payload": {"$ref": "#/$defs/rollbackCandidatesRequest"}
      }
    },
    {
      "type": "object",
      "required": ["operation", "payload"],
      "additionalProperties": false,
      "properties": {
        "operation": {"const": "GUI Shell編集適用先照合"},
        "payload": {"$ref": "#/$defs/editApplyTargetRequest"}
      }
    },
    {
      "type": "object",
      "required": ["operation", "payload"],
      "additionalProperties": false,
      "properties": {
        "operation": {"const": "GUI Shell編集提案審査"},
        "payload": {
          "type": "object",
          "required": [
            "version", "proposal", "proposal_audit_id", "workspace_id",
            "registration_hash", "baseline_hash", "approval_id"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {"const": 1},
            "proposal": {"$ref": "gui_shell_edit_proposal.schema.json"},
            "proposal_audit_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
            "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
            "registration_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "baseline_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域一覧"
        },
        "payload": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域承認"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "登録hash",
            "表示範囲"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "登録hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "表示範囲": {
              "type": "string",
              "enum": [
                "none",
                "hash_only",
                "summary",
                "redacted",
                "full"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域失効"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "登録hash"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "登録hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域ツリー"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "type": "string",
              "maxLength": 1024
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域読取"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域差分"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path",
            "基準点hash"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "基準点hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域基準点保存"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "登録hash",
            "相対paths"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "登録hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "相対paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域比較範囲"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "const": ""
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域全体基準点保存"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "登録hash"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "登録hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域変更一覧"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path",
            "基準点hash"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "const": ""
            },
            "基準点hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "作業領域復旧プレビュー"
        },
        "payload": {
          "type": "object",
          "required": [
            "作業領域ID",
            "相対path",
            "基準点hash"
          ],
          "additionalProperties": false,
          "properties": {
            "作業領域ID": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "相対path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "基準点hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  ],
  "type": "object"
}
