{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/regression_case_list.schema.json",
  "title": "回帰Case公開metadata一覧",
  "description": "通常IPCへ返せる限定metadataだけを含む。private定義、入力本文、条件、参照、期待経路を含めない。",
  "type": "object",
  "required": ["版", "回帰Case一覧", "件数", "合計件数", "次cursor", "公開範囲", "証拠種別"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "回帰Case一覧": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    },
    "件数": { "type": "integer", "minimum": 0, "maximum": 100 },
    "合計件数": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "次cursor": { "type": ["integer", "null"], "minimum": 0 },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$(?![\\s\\S])" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])" },
    "item": {
      "type": "object",
      "required": ["回帰CaseID", "定義hash", "暗号文hash", "公開表示名", "要求ID", "要求hash", "実行系ID", "結果状態", "応答hash", "終了監査ID", "必要条件数", "禁止条件数", "必要参照数", "作成時刻UnixMillis", "作成監査ID", "公開範囲", "証拠種別"],
      "additionalProperties": false,
      "properties": {
        "回帰CaseID": { "$ref": "#/$defs/id" },
        "定義hash": { "$ref": "#/$defs/hash" },
        "暗号文hash": { "$ref": "#/$defs/hash" },
        "公開表示名": { "type": "string", "minLength": 1, "maxLength": 128 },
        "要求ID": { "$ref": "#/$defs/id" },
        "要求hash": { "$ref": "#/$defs/hash" },
        "実行系ID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])" },
        "結果状態": { "type": "string", "enum": ["成功", "保留"] },
        "応答hash": { "$ref": "#/$defs/hash" },
        "終了監査ID": { "type": "string", "minLength": 1 },
        "必要条件数": { "type": "integer", "minimum": 0, "maximum": 16 },
        "禁止条件数": { "type": "integer", "minimum": 0, "maximum": 16 },
        "必要参照数": { "type": "integer", "minimum": 0, "maximum": 64 },
        "作成時刻UnixMillis": { "type": "integer", "minimum": 0 },
        "作成監査ID": { "type": "string", "minLength": 1 },
        "公開範囲": { "const": "metadata_only" },
        "証拠種別": { "const": "INTERNAL_STATE" }
      }
    }
  }
}
