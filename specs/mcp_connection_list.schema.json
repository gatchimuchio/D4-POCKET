{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mcp_connection_list.schema.json",
  "title": "MCP接続一覧（McpConnectionList）",
  "type": "object",
  "required": ["版", "MCP接続一覧", "件数", "公開範囲", "証拠種別"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "MCP接続一覧": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/receipt" }
    },
    "件数": { "type": "integer", "minimum": 0, "maximum": 128 },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "required": ["版", "契約種別", "Server", "Transport", "Tool", "Resource", "Prompt", "Credential ref", "Trust", "Capability diff", "権限生成", "公開範囲", "証拠種別", "接続状態", "能力ID", "権限ID", "承認状態", "復旧ID", "接続監査ID", "実行状態"],
      "additionalProperties": false,
      "properties": {
        "版": { "const": 1 },
        "契約種別": { "const": "MCP外部概念射影" },
        "Server": { "type": "object" },
        "Transport": { "type": "object" },
        "Tool": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/tool_projection" } },
        "Resource": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/resource_projection" } },
        "Prompt": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/prompt_projection" } },
        "Credential ref": { "$ref": "#/$defs/credential_reference" },
        "Trust": { "type": "object" },
        "Capability diff": { "type": "object" },
        "権限生成": { "const": "なし" },
        "公開範囲": { "const": "metadata_only" },
        "証拠種別": { "const": "INTERNAL_STATE" },
        "接続状態": { "enum": ["connected", "quarantined"] },
        "実行状態": { "enum": ["ready", "quarantined"] },
        "能力ID": { "const": "mcp.connection.connect" },
        "権限ID": { "const": "permission.mcp.connection.connect" },
        "承認状態": { "const": "owner_control_approved" },
        "復旧ID": { "const": "recover-mcp-connection" },
        "接続監査ID": { "type": "string", "minLength": 1 }
      }
    },
    "tool_projection": {
      "type": "object",
      "required": ["tool_id", "name", "description_summary", "input_schema_hash", "risk", "status"],
      "additionalProperties": false,
      "properties": {
        "tool_id": { "type": "string", "pattern": "^tool-[a-f0-9]{1,251}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description_summary": { "const": "" },
        "input_schema_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "risk": { "const": "unknown" },
        "status": {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "supported" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "resource_projection": {
      "type": "object",
      "required": ["resource_id", "name", "uri_template_hash", "mime_type", "status"],
      "additionalProperties": false,
      "properties": {
        "resource_id": { "type": "string", "pattern": "^resource-[a-f0-9]{1,247}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "uri_template_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "mime_type": { "const": "application/octet-stream" },
        "status": {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "supported" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "credential_reference": {
      "type": "object",
      "required": ["credential_id", "purpose", "target", "required", "status"],
      "additionalProperties": false,
      "properties": {
        "credential_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "purpose": { "const": "mcp_transport" },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" },
        "status": { "enum": ["configured", "missing"] },
        "environment_variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "configured" } }, "required": ["status"] },
          "then": { "required": ["environment_variable"], "properties": { "required": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "properties": { "required": { "const": false } }, "not": { "required": ["environment_variable"] } }
        }
      ]
    },
    "prompt_projection": {
      "type": "object",
      "required": ["prompt_id", "name", "description_summary", "argument_schema_hash", "status"],
      "additionalProperties": false,
      "properties": {
        "prompt_id": { "type": "string", "pattern": "^prompt-[a-f0-9]{1,249}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description_summary": { "const": "" },
        "argument_schema_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "supported" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
