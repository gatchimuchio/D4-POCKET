{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/a2a_connection_receipt.schema.json",
  "title": "A2A接続receipt（A2aConnectionReceipt）",
  "description": "A2A Agent CardのLIVE_RUNTIME metadataとBroker統治結果だけを返す。接続先実値、Credential実値、raw contentは返さない。",
  "type": "object",
  "required": ["版", "契約種別", "protocol_version", "AgentID", "Agent Card", "Task", "Message", "Artifact", "Stream", "Trust", "Capability diff", "権限生成", "authority_strip", "公開範囲", "証拠種別", "接続状態", "能力ID", "権限ID", "承認状態", "復旧ID", "接続監査ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "契約種別": { "const": "A2A外部概念射影" },
    "protocol_version": { "const": "1.0" },
    "AgentID": { "$ref": "#/$defs/id" },
    "Agent Card": { "$ref": "#/$defs/agent_card" },
    "Task": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false } },
    "Message": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false } },
    "Artifact": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false } },
    "Stream": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/stream" } },
    "Trust": { "$ref": "#/$defs/trust" },
    "Capability diff": { "$ref": "#/$defs/capability_diff" },
    "権限生成": { "const": "なし" },
    "authority_strip": { "const": true },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "enum": ["LIVE_RUNTIME", "INTERNAL_STATE"] },
    "接続状態": { "enum": ["connected", "restored_pending_review"] },
    "能力ID": { "const": "a2a.connection.connect" },
    "権限ID": { "const": "permission.a2a.connection.connect" },
    "承認状態": { "enum": ["owner_control_approved", "owner_reapproval_required"] },
    "復旧ID": { "const": "recover-a2a-connection" },
    "接続監査ID": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])" },
    "credential_ref": {
      "type": "object",
      "required": ["credential_id", "purpose", "target", "required", "status"],
      "additionalProperties": false,
      "properties": {
        "credential_id": { "type": "string", "pattern": "^[a-f0-9]{32}$(?![\\s\\S])" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" },
        "status": { "enum": ["configured", "missing", "revoked", "unknown"] }
      }
    },
    "agent_card": {
      "type": "object",
      "required": ["agent_id", "display_name", "description_summary", "version", "endpoint_hash", "supported_interfaces", "capabilities", "skills", "authentication", "origin", "status"],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description_summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "endpoint_hash": { "$ref": "#/$defs/hash" },
        "supported_interfaces": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["binding", "transport", "status", "reason"], "additionalProperties": false,
            "properties": {
              "binding": { "enum": ["jsonrpc", "grpc", "http_rest", "unknown"] },
              "transport": { "enum": ["http", "https", "unknown"] },
              "status": { "enum": ["supported", "unsupported", "unknown"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "capabilities": {
          "type": "object", "required": ["streaming", "push_notifications", "state_transition_history", "extended_agent_card"], "additionalProperties": false,
          "properties": {
            "streaming": { "type": "boolean" },
            "push_notifications": { "type": "boolean" },
            "state_transition_history": { "type": "boolean" },
            "extended_agent_card": { "type": "boolean" }
          }
        },
        "skills": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false } },
        "authentication": {
          "type": "object", "required": ["schemes", "credential_ref", "secret_value_present"], "additionalProperties": false,
          "properties": {
            "schemes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "credential_ref": { "$ref": "#/$defs/credential_ref" },
            "secret_value_present": { "const": false }
          }
        },
        "origin": { "const": "live_runtime" },
        "status": { "const": "discovered" }
      }
    },
    "stream": {
      "type": "object", "required": ["stream_id", "task_id", "mode", "status", "event_types", "resumable", "authority_strip"], "additionalProperties": false,
      "properties": {
        "stream_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["sse", "websocket", "grpc", "polling", "unsupported", "unknown"] },
        "status": { "type": "object", "required": ["status", "reason"], "additionalProperties": false, "properties": { "status": { "enum": ["supported", "unsupported", "unknown"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 512 } } },
        "event_types": { "type": "array", "maxItems": 16, "items": { "enum": ["task_status_update", "artifact_update", "message_update", "unknown"] } },
        "resumable": { "type": "boolean" },
        "authority_strip": { "const": true }
      }
    },
    "trust": {
      "type": "object", "required": ["state", "evidence_source", "reason", "requires_operator_review"], "additionalProperties": false,
      "properties": {
        "state": { "enum": ["unverified", "pending_review", "verified", "quarantined", "rejected"] },
        "evidence_source": { "const": "LIVE_RUNTIME" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requires_operator_review": { "const": true }
      }
    },
    "capability_diff": {
      "type": "object", "required": ["status", "added", "removed", "changed", "requires_operator_review", "evidence_source"], "additionalProperties": false,
      "properties": {
        "status": { "const": "not_evaluated" },
        "added": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "removed": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "changed": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "requires_operator_review": { "const": true },
        "evidence_source": { "const": "LIVE_RUNTIME" }
      }
    }
  }
}
