{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/host_stop.schema.json",
  "title": "Host表示コンテキスト停止要求（HostStop）",
  "description": "Host Center内の表示対象だけを解除する。遠隔HostやRuntimeのprocessを停止しない。",
  "type": "object",
  "required": ["版", "Host ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "Host ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
