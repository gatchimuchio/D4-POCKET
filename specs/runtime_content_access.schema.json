                      "properties": {
                        "開始時刻": {
                          "type": "null"
                        },
                        "開始監査ID": {
                          "type": "null"
                        },
                        "終了時刻": {
                          "type": "integer"
                        },
                        "終了監査ID": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "properties": {
                        "開始時刻": {
                          "type": "integer"
                        },
                        "開始監査ID": {
                          "type": "string"
                        },
                        "終了時刻": {
                          "type": "null"
                        },
                        "終了監査ID": {
                          "type": "null"
                        }
                      }
                    },
                    {
                      "properties": {
                        "開始時刻": {
                          "type": "integer"
                        },
                        "開始監査ID": {
                          "type": "string"
                        },
                        "終了時刻": {
                          "type": "integer"
