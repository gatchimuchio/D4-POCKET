{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/gui_shell_linux_export_build.schema.json",
  "title": "D4 Pocket Linux Export build記録",
  "type": "object",
  "required": [
    "version", "evidence_type", "evidence_source", "product", "target_platform", "build_mode",
    "source_ref", "source_commit", "source_archive_sha256", "source_receipt_sha256",
    "source_manifest_sha256", "export_id", "app_id", "audit_store_id", "authority_boundary",
    "module_plan", "toolchain", "pub_get_arguments", "flutter_build_arguments",
    "cmake_configure_arguments", "cmake_build_arguments", "compile_time_identity",
    "compile_time_update_trust", "build_duration_ms", "runtime_storage_root_template",
    "portable_bundle_assembled", "manifest_copied_byte_for_byte", "runtime_manifest_consumed",
    "binary_pruning_verified", "formal_distribution_claimed", "signed", "installer_status",
    "launch_status", "artifact_root", "artifact_files", "artifact_total_bytes",
    "artifact_tree_sha256", "package", "portable_archive", "credential_artifact_scan"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "evidence_type": { "const": "d4_pocket_linux_export_build" },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "product": { "const": "D4 Pocket" },
    "target_platform": { "const": "linux" },
    "build_mode": { "const": "release" },
    "source_ref": { "type": "string", "pattern": "^refs/heads/(main|codex/[A-Za-z0-9._/-]+)$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "export_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "app_id": { "type": "string", "pattern": "^d4-pocket-app-[0-9a-f]{32}$" },
    "audit_store_id": { "type": "string", "pattern": "^audit-store-[0-9a-f]{32}$" },
    "authority_boundary": {
      "type": "object",
      "required": ["source_authority_verified", "owner_authorization_verified", "authority_strip", "credential_values_explicitly_supplied", "credential_artifact_scan_status", "credential_inherited", "permission_inherited", "approval_inherited", "audit_chain_inherited"],
      "additionalProperties": false,
      "properties": {
        "source_authority_verified": { "const": false },
        "owner_authorization_verified": { "const": false },
        "authority_strip": { "const": true },
        "credential_values_explicitly_supplied": { "const": false },
        "credential_artifact_scan_status": { "const": "passed_known_patterns" },
        "credential_inherited": { "const": false },
        "permission_inherited": { "const": false },
        "approval_inherited": { "const": false },
        "audit_chain_inherited": { "const": false }
      }
    },
    "module_plan": {
      "type": "object",
      "required": ["catalog_version", "selection_mode", "requested_optional_module_ids", "unprunable_core_ids", "included_module_ids", "excluded_optional_module_ids"],
      "additionalProperties": false,
      "properties": {
        "catalog_version": { "const": 1 },
        "selection_mode": { "enum": ["all_optional", "explicit_optional"] },
        "requested_optional_module_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["shell.setup_doctor", "shell.history", "shell.evaluation_lab", "shell.host_capabilities", "shell.notifications", "shell.observability", "shell.trace_inspector", "shell.host_operations"] } },
        "unprunable_core_ids": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["core.security_broker", "core.cryptography", "core.audit_finality", "core.credentials", "core.os_controls", "core.permission_enforcement", "core.approval_enforcement", "core.content_exposure"] } },
        "included_module_ids": { "type": "array", "minItems": 18, "uniqueItems": true, "items": { "enum": ["core.security_broker", "core.cryptography", "core.audit_finality", "core.credentials", "core.os_controls", "core.permission_enforcement", "core.approval_enforcement", "core.content_exposure", "shell.dashboard", "shell.runtime_operation", "shell.agent_operation", "shell.authority", "shell.approval", "shell.audit", "shell.recovery", "shell.problems", "shell.evidence", "shell.settings", "shell.setup_doctor", "shell.history", "shell.evaluation_lab", "shell.host_capabilities", "shell.notifications", "shell.observability", "shell.trace_inspector", "shell.host_operations"] } },
        "excluded_optional_module_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["shell.setup_doctor", "shell.history", "shell.evaluation_lab", "shell.host_capabilities", "shell.notifications", "shell.observability", "shell.trace_inspector", "shell.host_operations"] } }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["flutter", "dart", "framework_revision", "cargo", "rustc", "cmake", "ninja", "pkg_config", "clang", "clangxx", "distribution_id", "distribution_version", "architecture"],
      "additionalProperties": false,
      "properties": {
        "flutter": { "type": "string", "minLength": 1 },
        "dart": { "type": "string", "minLength": 1 },
        "framework_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cargo": { "type": "string", "minLength": 1 },
        "rustc": { "type": "string", "minLength": 1 },
        "cmake": { "type": "string", "minLength": 1 },
        "ninja": { "type": "string", "minLength": 1 },
        "pkg_config": { "type": "string", "minLength": 1 },
        "clang": { "type": "string", "minLength": 1 },
        "clangxx": { "type": "string", "minLength": 1 },
        "distribution_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "distribution_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "pub_get_arguments": { "$ref": "#/$defs/argumentList" },
    "flutter_build_arguments": { "$ref": "#/$defs/argumentList" },
    "cmake_configure_arguments": { "$ref": "#/$defs/argumentList" },
    "cmake_build_arguments": { "$ref": "#/$defs/argumentList" },
    "compile_time_identity": {
      "type": "object",
      "required": ["source", "app_id", "audit_store_id"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "schema_validated_manifest" },
        "app_id": { "type": "string", "pattern": "^d4-pocket-app-[0-9a-f]{32}$" },
        "audit_store_id": { "type": "string", "pattern": "^audit-store-[0-9a-f]{32}$" }
      }
    },
    "compile_time_update_trust": {
      "type": "object",
      "required": ["source", "configured", "public_key_fingerprint", "package_source_count"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["schema_validated_manifest", "not_configured"] },
        "configured": { "type": "boolean" },
        "public_key_fingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "package_source_count": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "allOf": [
        { "if": { "properties": { "configured": { "const": true } }, "required": ["configured"] }, "then": { "properties": { "source": { "const": "schema_validated_manifest" }, "public_key_fingerprint": { "type": "string" }, "package_source_count": { "minimum": 1 } } }, "else": { "properties": { "source": { "const": "not_configured" }, "public_key_fingerprint": { "type": "null" }, "package_source_count": { "const": 0 } } } }
      ]
    },
    "build_duration_ms": { "type": "integer", "minimum": 0 },
    "runtime_storage_root_template": { "const": "$XDG_DATA_HOME/apps/d4-pocket/<App ID>/stores/<Audit store ID>" },
    "portable_bundle_assembled": { "const": true },
    "manifest_copied_byte_for_byte": { "const": true },
    "runtime_manifest_consumed": { "const": false },
    "binary_pruning_verified": { "const": false },
    "formal_distribution_claimed": { "const": false },
    "signed": { "const": false },
    "installer_status": { "const": "not_started" },
    "launch_status": { "const": "not_verified" },
    "artifact_root": { "const": "bundle" },
    "artifact_files": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "type": "object", "properties": { "path": { "const": "gui_shell_desktop" } } } },
        { "contains": { "type": "object", "properties": { "path": { "const": "gui_shell_desktop_launcher" } } } },
        { "contains": { "type": "object", "properties": { "path": { "const": "libexec/gui_shell_linux_broker" } } } },
        { "contains": { "type": "object", "properties": { "path": { "const": "lib/libflutter_linux_gtk.so" } } } },
        { "contains": { "type": "object", "properties": { "path": { "const": "data/icudtl.dat" } } } },
        { "contains": { "type": "object", "properties": { "path": { "const": "product_manifest.json" } } } }
      ],
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "artifact_total_bytes": { "type": "integer", "minimum": 1 },
    "artifact_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package": {
      "type": "object",
      "required": ["file_name", "format", "byte_length", "sha256", "signed", "installed_product_verified"],
      "additionalProperties": false,
      "properties": {
        "file_name": { "const": "D4Pocket-linux.d4pkg" },
        "format": { "const": "D4PKG01" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "const": false },
        "installed_product_verified": { "const": false }
      }
    },
    "portable_archive": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["file_name", "format", "target", "byte_length", "sha256", "entry_count", "readme_sha256", "signed"],
          "additionalProperties": false,
          "properties": {
            "file_name": { "type": "string", "pattern": "^D4Pocket-[A-Za-z0-9.+-]+-linux-x64-portable\\.tar\\.gz$" },
            "format": { "const": "tar.gz" },
            "target": { "const": "ubuntu-24.04-x86_64" },
            "byte_length": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "entry_count": { "type": "integer", "minimum": 2 },
            "readme_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signed": { "const": false }
          }
        }
      ]
    },
    "credential_artifact_scan": {
      "type": "object",
      "required": ["version", "status", "scope", "coverage", "files_scanned", "bytes_scanned", "findings", "artifact_tree_sha256"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "status": { "const": "passed_known_patterns" },
        "scope": { "const": "runtime_artifact_files" },
        "coverage": { "const": "known_patterns_only" },
        "files_scanned": { "type": "integer", "minimum": 6 },
        "bytes_scanned": { "type": "integer", "minimum": 1 },
        "findings": { "const": 0 },
        "artifact_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "argumentList": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
  }
}
