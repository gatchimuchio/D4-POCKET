{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/gui_shell_android_product_candidate.schema.json",
  "title": "D4 Pocket Android product candidate evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidence_type",
    "evidence_source",
    "source_commit",
    "source_clean",
    "application_id",
    "application_identity_confirmed",
    "version_code",
    "version_name",
    "toolchain",
    "artifacts",
    "distribution_ready",
    "formal_distribution_claimed",
    "publisher_identity_included",
    "credential_included",
    "installed_product_verified"
  ],
  "properties": {
    "version": { "const": 1 },
    "evidence_type": { "const": "d4_pocket_android_product_candidate" },
    "evidence_source": { "const": "INTERNAL_STATE" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_clean": { "const": true },
    "application_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "application_identity_confirmed": { "const": false },
    "version_code": { "type": "integer", "minimum": 1 },
    "version_name": { "type": "string", "pattern": "^[0-9][A-Za-z0-9.+_-]{0,63}$" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flutter", "java", "android_build_tools"],
      "properties": {
        "flutter": { "type": "string", "minLength": 1, "maxLength": 128 },
        "java": { "type": "string", "minLength": 1, "maxLength": 128 },
        "android_build_tools": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emulator_debug", "release_candidate"],
      "properties": {
        "emulator_debug": { "$ref": "#/$defs/debugArtifact" },
        "release_candidate": { "$ref": "#/$defs/releaseArtifact" }
      }
    },
    "distribution_ready": { "const": false },
    "formal_distribution_claimed": { "const": false },
    "publisher_identity_included": { "const": false },
    "credential_included": { "const": false },
    "installed_product_verified": { "const": false }
  },
  "$defs": {
    "baseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "size_bytes", "build_configuration", "signature_state", "native_abis"],
      "properties": {
        "file_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.apk$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 800000000 },
        "build_configuration": { "type": "string" },
        "signature_state": { "type": "string" },
        "native_abis": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
        }
      }
    },
    "debugArtifact": {
      "allOf": [
        { "$ref": "#/$defs/baseArtifact" },
        { "properties": { "file_name": { "const": "d4-pocket-android-emulator-debug.apk" }, "build_configuration": { "const": "debug" }, "signature_state": { "const": "debug_signed" } } }
      ]
    },
    "releaseArtifact": {
      "allOf": [
        { "$ref": "#/$defs/baseArtifact" },
        { "properties": { "file_name": { "const": "d4-pocket-android-release-unsigned.apk" }, "build_configuration": { "const": "release" }, "signature_state": { "const": "unsigned" } } }
      ]
    }
  }
}
