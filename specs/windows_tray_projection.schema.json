{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/windows_tray_projection.schema.json",
  "title": "Windows常駐トレイ表示射影（WindowsTrayProjection）",
  "type": "object",
  "required": ["version", "runtime_status", "pending_approval_count", "critical_notification_count", "evidence_source", "stop_request_supported"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "evidence_source": { "const": "不明" } } },
      "then": {
        "properties": {
          "pending_approval_count": { "const": "不明" },
          "critical_notification_count": { "const": "不明" }
        }
      }
    }
  ],
  "properties": {
    "version": { "const": 1 },
    "runtime_status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "pending_approval_count": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 256 }, { "const": "不明" }] },
    "critical_notification_count": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 256 }, { "const": "不明" }] },
    "evidence_source": { "enum": ["INTERNAL_STATE", "不明"] },
    "stop_request_supported": { "type": "boolean" }
  }
}
