{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mcp_tool_action_preview.schema.json",
  "title": "Compose MCP Tool実行Preview要求",
  "description": "現在Catalog、Compose dependency、Tool arguments schemaと一回Permission scopeを読み取り検査する。Tool effect、Permission、Approvalを生成しない。",
  "type": "object",
  "required": ["版", "操作", "ServerID", "ToolID", "名前", "arguments", "compose_manifest"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "操作": { "const": "Preview" },
    "ServerID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ToolID": { "type": "string", "pattern": "^tool-[a-f0-9]{142}$" },
    "名前": { "type": "string", "minLength": 1, "maxLength": 256 },
    "arguments": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "not": { "pattern": "(?i)(authority|permission|approval|capability|credential|secret|password|token|api[_-]?key|authorization)" } },
      "additionalProperties": true
    },
    "compose_manifest": { "$ref": "gui_shell_compose.schema.json" }
  }
}
