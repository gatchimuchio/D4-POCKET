{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/a2a_task_get_request.schema.json",
  "title": "A2A一回Task状態取得要求（A2aTaskGetRequest）",
  "description": "Task IDへ束縛した、無認証A2A v1.0 JSON-RPC GetTask要求。履歴、Credential、Authorityを要求しない。",
  "type": "object",
  "required": ["版", "操作", "AgentID", "Interface URI", "TaskID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "操作": { "const": "状態取得" },
    "AgentID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])" },
    "Interface URI": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://" },
    "TaskID": { "type": "string", "minLength": 1, "maxLength": 256, "description": "SendMessageが返した未信頼Task ID。Brokerが現在のAgent receipt、interface hash、要求IDを再検証する。" }
  }
}
