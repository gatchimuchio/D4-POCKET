{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mcp_tool_call.schema.json",
  "title": "MCP Tool実行要求（McpToolCallRequest）",
  "description": "native Owner確認後に限るTool呼出し。authority fieldやCredential実値を要求へ含めない。",
  "type": "object",
  "required": ["版", "操作", "ServerID", "ToolID", "名前", "arguments"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "操作": { "const": "実行" },
    "ServerID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ToolID": { "type": "string", "pattern": "^tool-[a-f0-9]{142}$" },
    "名前": { "type": "string", "minLength": 1, "maxLength": 256 },
    "arguments": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "not": { "pattern": "(?i)(authority|permission|approval|capability|credential|secret|password|token|api[_-]?key|authorization)" } },
      "additionalProperties": true
    },
    "compose_manifest": {
      "$ref": "gui_shell_compose.schema.json",
      "description": "Composeからの呼出しではBrokerが現在Catalogと選択Server／Toolを再検査する。Manifestから権限を継承しない。"
    },
    "source_agent_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "提案元Agent Task。Brokerは保存済みTask結果と完全一致を再検証する。"
    },
    "source_agent_result_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "提案元Task結果hash。Tool実行Permissionではない。"
    }
  },
  "allOf": [
    {
      "if": { "required": ["source_agent_task_id"] },
      "then": { "required": ["source_agent_result_hash"] }
    },
    {
      "if": { "required": ["source_agent_result_hash"] },
      "then": { "required": ["source_agent_task_id"] }
    }
  ]
}
