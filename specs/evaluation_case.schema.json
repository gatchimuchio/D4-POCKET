{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/evaluation_case.schema.json",
  "title": "評価Case静的hash_only contract",
  "description": "owner登録payloadから導く評価Caseの静的hash_only contract。これはnormal IPCのruntime API payloadではない。runtimeのevaluation_dataset公開manifestはCaseIDと定義hashだけをCase一覧へ出し、入力hash、期待本文、Evaluator設定本文を含めない。",
  "type": "object",
  "required": [
    "版",
    "評価DatasetID",
    "Dataset定義hash",
    "評価CaseID",
    "順序",
    "公開表示名",
    "入力hash",
    "定義hash",
    "評価器一覧",
    "公開範囲"
  ],
  "additionalProperties": false,
  "properties": {
    "版": {
      "const": 1
    },
    "評価DatasetID": {
      "$ref": "#/$defs/id"
    },
    "Dataset定義hash": {
      "$ref": "#/$defs/hash"
    },
    "評価CaseID": {
      "$ref": "#/$defs/id"
    },
    "順序": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "公開表示名": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "入力hash": {
      "$ref": "#/$defs/hash"
    },
    "定義hash": {
      "$ref": "#/$defs/hash"
    },
    "評価器一覧": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "評価器ID",
          "定義hash"
        ],
        "additionalProperties": false,
        "properties": {
          "評価器ID": {
            "$ref": "#/$defs/id"
          },
          "定義hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "公開範囲": {
      "const": "hash_only"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    }
  }
}
