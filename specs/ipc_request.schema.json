{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/ipc_request.schema.json",
  "title": "IPC要求（IpcRequest）",
  "type": "object",
  "required": [
    "request_id",
    "operation",
    "payload_hash",
    "nonce",
    "issued_at",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "health",
        "shutdown",
        "command_envelope",
        "authority_evaluate",
        "authority_fixture_evaluate",
        "approval_edit",
        "content_projection",
        "audit_verify",
        "normalize_payload",
        "実行系列挙",
        "対話開始",
        "対話送信",
        "対話取得",
        "対話中止",
        "対話終了",
        "対話承認",
        "対話承認待ち",
        "端末招待",
        "端末一覧",
        "端末招待取消",
        "端末失効",
        "作業領域一覧",
        "作業領域承認",
        "作業領域失効",
        "作業領域ツリー",
        "作業領域読取",
        "作業領域基準点保存",
        "作業領域差分",
        "作業領域比較範囲",
        "作業領域全体基準点保存",
        "作業領域変更一覧",
        "作業領域復旧プレビュー",
        "対話履歴一覧",
        "対話履歴承認",
        "対話履歴失効",
        "対話履歴閲覧状態",
        "対話履歴閲覧",
        "対話再実行",
        "対話分岐",
        "対話内容保存",
        "対話内容承認",
        "対話内容失効",
        "対話内容閲覧状態",
        "対話内容閲覧"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "payload": {
      "description": "スキーマ形状を持つ操作内容です。ブローカーは操作固有の意味を検証し、これを権限として信頼してはなりません。",
      "additionalProperties": true
    }
  }
}
