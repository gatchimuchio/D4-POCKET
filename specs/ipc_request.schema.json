{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/ipc_request.schema.json",
  "title": "IpcRequest",
  "type": "object",
  "required": [
    "request_id",
    "operation",
    "payload_hash",
    "nonce",
    "issued_at",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "health",
        "shutdown",
        "command_envelope"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
