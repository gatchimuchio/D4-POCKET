{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/approval.schema.json",
  "title": "承認（Approval）",
  "type": "object",
  "required": [
    "approval_id",
    "runtime_id",
    "operation",
    "target_scope",
    "status",
    "content_visibility",
    "payload_hash",
    "editable_fields"
  ],
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "requires_validation"
      ]
    },
    "content_visibility": {
      "type": "string",
      "enum": [
        "none",
        "hash_only",
        "summary",
        "redacted",
        "full"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string"
    },
    "redacted_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "full_payload": {
      "type": "object",
      "description": "保管専用の完全内容です。content_visibility=fullでない限り、UI射影で公開してはなりません。",
      "additionalProperties": true
    },
    "editable_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "権限を持たない項目のうち、ここで列挙した項目だけ編集できます。"
    },
    "sealed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UIで表示または編集してはならない項目です。"
    },
    "sacred_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UIまたはアダプターで編集してはならない領域重要項目です。"
    },
    "authority_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
