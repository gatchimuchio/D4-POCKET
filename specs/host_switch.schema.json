{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/host_switch.schema.json",
  "title": "Host切替要求（HostSwitch）",
  "description": "通常IPCの表示コンテキストだけを切り替える。Permission、Approval、Authorityは入力しない。",
  "type": "object",
  "required": ["版", "Host ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "Host ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
