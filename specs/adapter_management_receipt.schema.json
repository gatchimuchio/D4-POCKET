{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/adapter_management_receipt.schema.json",
  "title": "アダプター管理receipt（AdapterManagementReceipt）",
  "type": "object",
  "required": [
    "版",
    "Adapter ID",
    "Runtime ID",
    "発行者",
    "source",
    "version",
    "transport",
    "Content Exposure",
    "要求Capability",
    "許可差分",
    "既知の危険",
    "互換性",
    "hash",
    "署名状態",
    "検証状態",
    "管理状態",
    "有効状態",
    "更新可能",
    "公開範囲",
    "証拠種別",
    "権限生成",
    "authority_strip",
    "最終検証",
    "監査ID",
    "復旧ID"
  ],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "Adapter ID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "Runtime ID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "発行者": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": { "enum": ["owner_manifest", "local_bundle", "builtin"] },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "transport": { "enum": ["http", "stdio", "ipc", "mock"] },
    "Content Exposure": { "enum": ["none", "hash_only", "summary", "redacted", "full"] },
    "要求Capability": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
    "許可差分": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
    "既知の危険": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
    "互換性": { "enum": ["compatible", "incompatible", "unknown"] },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "署名状態": { "enum": ["verified", "unconfigured", "invalid", "unverified"] },
    "検証状態": { "enum": ["verified", "pending_review", "rejected", "unverified"] },
    "管理状態": { "enum": ["installed", "verified", "enabled", "disabled", "quarantined"] },
    "有効状態": { "enum": ["inactive", "active", "blocked"] },
    "更新可能": { "type": "boolean" },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" },
    "権限生成": { "const": "なし" },
    "authority_strip": { "const": true },
    "操作": { "enum": ["導入", "検証", "有効化", "無効化", "隔離", "更新", "削除"] },
    "実行状態": { "enum": ["accepted", "suspended", "removed"] },
    "承認状態": { "enum": ["owner_control_approved", "owner_reapproval_required"] },
    "最終検証": { "type": ["string", "null"] },
    "監査ID": { "type": "string", "minLength": 1 },
    "復旧ID": { "const": "recover-adapter-management" }
  }
}
