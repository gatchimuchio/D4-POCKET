{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/credential_receipt.schema.json",
  "title": "資格情報公開receipt",
  "description": "資格情報登録・一覧・失効の公開metadata。秘密値、復号payload、Credential実値、owner資格を含めず、metadata_onlyの投影に限定する。",
  "type": "object",
  "required": [
    "版",
    "資格情報ID",
    "用途",
    "接続対象",
    "種類",
    "保管方式",
    "状態",
    "作成時刻UnixMillis",
    "最終使用時刻UnixMillis",
    "失効時刻UnixMillis",
    "暗号文hash",
    "作成監査ID",
    "公開範囲",
    "証拠種別"
  ],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "資格情報ID": { "$ref": "#/$defs/id" },
    "用途": { "type": "string", "minLength": 1, "maxLength": 128 },
    "接続対象": { "type": "string", "minLength": 1, "maxLength": 256 },
    "種類": {
      "type": "string",
      "enum": ["api_key", "oauth", "basic", "ssh", "custom"]
    },
    "保管方式": { "enum": ["windows_dpapi", "macos_keychain"] },
    "状態": { "enum": ["有効", "失効"] },
    "作成時刻UnixMillis": { "type": "integer", "minimum": 0 },
    "最終使用時刻UnixMillis": { "type": ["integer", "null"], "minimum": 0 },
    "失効時刻UnixMillis": { "type": ["integer", "null"], "minimum": 0 },
    "暗号文hash": { "$ref": "#/$defs/hash" },
    "作成監査ID": { "$ref": "#/$defs/audit_id" },
    "公開範囲": { "const": "metadata_only" },
    "証拠種別": { "const": "INTERNAL_STATE" }
  },
  "allOf": [
    {
      "if": { "properties": { "状態": { "const": "有効" } } },
      "then": { "properties": { "失効時刻UnixMillis": { "type": "null" } } }
    },
    {
      "if": { "properties": { "状態": { "const": "失効" } } },
      "then": { "properties": { "失効時刻UnixMillis": { "type": "integer", "minimum": 0 } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
