{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/mcp_connection.schema.json",
  "title": "MCP接続要求（McpConnection）",
  "description": "owner controlが開始するstdio MCP接続要求。Credential実値、Authority、Approvalは含めない。",
  "type": "object",
  "required": ["版", "操作", "ServerID", "実行file", "引数", "workspace", "Transport", "Credential ref"],
  "additionalProperties": false,
  "$defs": {
    "credential_reference": {
      "type": "object",
      "required": ["credential_id", "purpose", "target", "required", "status"],
      "additionalProperties": false,
      "properties": {
        "credential_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "purpose": { "const": "mcp_transport" },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" },
        "status": { "enum": ["configured", "missing"] },
        "environment_variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "configured" } }, "required": ["status"] },
          "then": { "required": ["environment_variable"], "properties": { "required": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "properties": { "required": { "const": false } }, "not": { "required": ["environment_variable"] } }
        }
      ]
    }
  },
  "properties": {
    "版": { "const": 1 },
    "操作": { "const": "接続" },
    "ServerID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "実行file": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "引数": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "workspace": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "Transport": { "const": "stdio" },
    "Credential ref": { "$ref": "#/$defs/credential_reference" }
  }
}
