{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/evaluation_experiment.schema.json",
  "title": "評価Experiment安全projection",
  "description": "Dataset revisionに束縛された評価実験の状態projection。評価自体はAuthorityまたはrelease判断を生成しない。完了は全Case×RuntimeのResultと開始・終了時刻を必要とする。結果数の件数関係と、開始・終了時刻の非null・時系列整合はtooling/evaluation_contract_check.pyとBrokerが検査する。",
  "type": "object",
  "required": [
    "版",
    "評価ExperimentID",
    "評価DatasetID",
    "Dataset定義hash",
    "対象Runtime一覧",
    "状態",
    "計画Case数",
    "結果数",
    "作成時刻UnixMillis",
    "開始時刻UnixMillis",
    "終了時刻UnixMillis",
    "計画監査ID",
    "実験監査ID",
    "証拠種別"
  ],
  "additionalProperties": false,
  "properties": {
    "版": {
      "const": 1
    },
    "評価ExperimentID": {
      "$ref": "#/$defs/id"
    },
    "評価DatasetID": {
      "$ref": "#/$defs/id"
    },
    "Dataset定義hash": {
      "$ref": "#/$defs/hash"
    },
    "対象Runtime一覧": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/runtime_id"
      }
    },
    "状態": {
      "type": "string",
      "enum": [
        "準備済み",
        "承認待ち",
        "実行中",
        "完了",
        "中断",
        "評価不能"
      ]
    },
    "計画Case数": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "結果数": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "作成時刻UnixMillis": {
      "type": "integer",
      "minimum": 0
    },
    "開始時刻UnixMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "終了時刻UnixMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "計画監査ID": {
      "$ref": "#/$defs/audit_id",
      "description": "Case/Runtimeごとの対話request・session・request hash、Session開始要求/開始、送信要求/送信内容hash、作成、隔離要求/隔離の各監査IDを保持する不変な計画監査recordへの相関。private入力とEvaluator設定は含めない。"
    },
    "実験監査ID": {
      "$ref": "#/$defs/audit_id"
    },
    "証拠種別": {
      "const": "INTERNAL_STATE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "状態": {
            "const": "完了"
          }
        },
        "required": [
          "状態"
        ]
      },
      "then": {
        "properties": {
          "開始時刻UnixMillis": {
            "type": "integer",
            "minimum": 0
          },
          "終了時刻UnixMillis": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
