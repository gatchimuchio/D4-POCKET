{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/credential_revocation_request.schema.json",
  "title": "資格情報失効要求",
  "description": "Rust Desktop native Owner確認へ登録済みCredentialを結び付ける一件だけの論理失効要求。必要な公開metadataのみを受け付け、秘密値、Authority、Permission、Approvalは受け付けない。",
  "type": "object",
  "required": ["版", "資格情報ID", "用途", "接続対象", "暗号文hash", "作成監査ID"],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "資格情報ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    },
    "用途": { "type": "string", "minLength": 1, "maxLength": 256 },
    "接続対象": { "type": "string", "minLength": 1, "maxLength": 256 },
    "暗号文hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "作成監査ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    }
  }
}
