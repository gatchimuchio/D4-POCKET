{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gui-shell/schemas/credential_registration.schema.json",
  "title": "資格情報 owner登録payload",
  "description": "owner control経路だけが扱う新規資格情報登録。秘密値はWindows ProtectedStoreへ保存し、応答・Audit・通常IPCへ返さない。同じ資格情報IDの再登録を許可せず、資格情報からAuthority、Permission、Approvalを生成しない。更新・物理削除・接続先変更は別の未接続操作である。",
  "type": "object",
  "required": [
    "版",
    "操作",
    "資格情報ID",
    "用途",
    "接続対象",
    "種類",
    "保管方式",
    "登録者種別",
    "登録経路",
    "秘密値"
  ],
  "additionalProperties": false,
  "properties": {
    "版": { "const": 1 },
    "操作": { "const": "追加" },
    "資格情報ID": { "$ref": "#/$defs/id" },
    "用途": { "type": "string", "minLength": 1, "maxLength": 128 },
    "接続対象": { "type": "string", "minLength": 1, "maxLength": 256 },
    "種類": {
      "type": "string",
      "enum": ["api_key", "oauth", "basic", "ssh", "custom"]
    },
    "保管方式": { "enum": ["windows_dpapi", "macos_keychain"] },
    "登録者種別": { "const": "owner" },
    "登録経路": { "const": "owner_control" },
    "秘密値": { "type": "string", "minLength": 1, "maxLength": 65536 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
    }
  }
}
