working_directory: C:\Users\mzcum\Documents\GUI-Shell
command: Get-ChildItem release_evidence -Recurse -Filter *.json | ForEach-Object {
  $json = Get-Content -Raw $_.FullName | ConvertFrom-Json
  [pscustomobject]@{
    path = $_.FullName
    sha256 = (Get-FileHash $_.FullName -Algorithm SHA256).Hash
    status = $json.status
    classification = $json.classification
    evidence_source = $json.evidence_source
    blocks_release = $json.blocks_release
    reason = $json.reason
    required_action = $json.required_action
    commit_sha = if ($json.provenance) { $json.provenance.source_commit } elseif ($json.source_commit) { $json.source_commit } else { $null }
    app_artifact_hash = if ($json.provenance) { $json.provenance.app_artifact_sha256 } else { $null }
    broker_artifact_hash = if ($json.provenance) { $json.provenance.broker_artifact_sha256 } else { $null }
    installed_path = if ($json.provenance) { $json.provenance.isolated_install_root } elseif ($json.installed_path) { $json.installed_path } else { $null }
    native_windows_installed_path = $json.native_windows_installed_path
    has_owner_go = ($json.PSObject.Properties.Name -contains 'owner_go')
    owner_go_value = $json.owner_go
    has_release_ready = ($json.PSObject.Properties.Name -contains 'release_ready')
    release_ready_value = $json.release_ready
    fixture_marker = ($json | ConvertTo-Json -Depth 30) -match 'FIXTURE|fixture|development_evidence|CONFIG'
  }
} | ConvertTo-Json -Depth 6
exit_code: 0
